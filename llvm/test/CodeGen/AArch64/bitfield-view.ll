; Composed bit fields become one bit-field extract.

; ((x >> 4) & 255) >> 2 & 15 is zext(x[6, 10)).
define i32 @nested_unsigned(i32 %x) {
; CHECK-LABEL: nested_unsigned:
; CHECK:       // %bb.0:
; CHECK-NEXT:    ubfx w0, w0, #6, #4
; CHECK-NEXT:    ret
  %a = lshr i32 %x, 4
  %b = and i32 %a, 255
  %c = lshr i32 %b, 2
  %d = and i32 %c, 15
  ret i32 %d
}

; ((x >>a 4) << 16) >>a 20 is sext(x[8, 20)).
define i32 @nested_signed(i32 %x) {
; CHECK-LABEL: nested_signed:
; CHECK:       // %bb.0:
; CHECK-NEXT:    sbfx w0, w0, #8, #12
; CHECK-NEXT:    ret
  %a = ashr i32 %x, 4
  %b = shl i32 %a, 16
  %c = ashr i32 %b, 20
  ret i32 %c
}

; ((x >> 3) & 0xfff) << 20 >>a 24 is sext(x[7, 15)).
define i32 @nested_mixed(i32 %x) {
; CHECK-LABEL: nested_mixed:
; CHECK:       // %bb.0:
; CHECK-NEXT:    sbfx w0, w0, #7, #8
; CHECK-NEXT:    ret
  %a = lshr i32 %x, 3
  %b = and i32 %a, 4095
  %c = shl i32 %b, 20
  %d = ashr i32 %c, 24
  ret i32 %d
}

; trunc((x >> 20) & 0xffff) >> 4 & 0xff of an i64 x is zext(x[24, 32)).
define i32 @field_of_i64(i64 %x) {
; SDAG-LABEL: field_of_i64:
; SDAG:       // %bb.0:
; SDAG-NEXT:    lsr w0, w0, #24
; SDAG-NEXT:    // kill: def $w0 killed $w0 killed $x0
; SDAG-NEXT:    ret
;
; GISEL-LABEL: field_of_i64:
; GISEL:       // %bb.0:
; GISEL-NEXT:    lsr w0, w0, #24
; GISEL-NEXT:    ret
  %a = lshr i64 %x, 20
  %b = and i64 %a, 65535
  %c = trunc i64 %b to i32
  %d = lshr i32 %c, 4
  %e = and i32 %d, 255
  ret i32 %e
}

; zext(x[28, 40)) of an i64 x.
define i64 @nested_i64(i64 %x) {
; CHECK-LABEL: nested_i64:
; CHECK:       // %bb.0:
; CHECK-NEXT:    ubfx x0, x0, #28, #12
; CHECK-NEXT:    ret
  %a = lshr i64 %x, 24
  %b = and i64 %a, 1048575
  %c = lshr i64 %b, 4
  %d = and i64 %c, 4095
  ret i64 %d
}

; (zext(lo) | zext(hi) << 16) >> 20 & 0xff is zext(hi[4, 12)).
define i32 @field_of_concat(i16 %lo, i16 %hi) {
; CHECK-LABEL: field_of_concat:
; CHECK:       // %bb.0:
; CHECK-NEXT:    ubfx w0, w1, #4, #8
; CHECK-NEXT:    ret
  %l = zext i16 %lo to i32
  %h = zext i16 %hi to i32
  %hs = shl i32 %h, 16
  %v = or i32 %l, %hs
  %s = lshr i32 %v, 20
  %r = and i32 %s, 255
  ret i32 %r
}

; Bits [36, 44) of the i64 concatenation of lo and hi are hi[4, 12).
define i32 @field_of_concat_i64(i32 %lo, i32 %hi) {
; CHECK-LABEL: field_of_concat_i64:
; CHECK:       // %bb.0:
; CHECK-NEXT:    ubfx w0, w1, #4, #8
; CHECK-NEXT:    ret
  %l = zext i32 %lo to i64
  %h = zext i32 %hi to i64
  %hs = shl i64 %h, 32
  %v = or i64 %l, %hs
  %s = lshr i64 %v, 36
  %t = trunc i64 %s to i32
  %r = and i32 %t, 255
  ret i32 %r
}

; The mask 0xf0f selects two fields: not a field of x.
define i32 @two_field_mask(i32 %x) {
; CHECK-LABEL: two_field_mask:
; CHECK:       // %bb.0:
; CHECK-NEXT:    mov w8, #963 // =0x3c3
; CHECK-NEXT:    and w0, w8, w0, lsr #6
; CHECK-NEXT:    ret
  %a = lshr i32 %x, 4
  %b = and i32 %a, 3855
  %c = lshr i32 %b, 2
  %d = and i32 %c, 1023
  ret i32 %d
}

; A shift by 40 of an i32 value is poison.
define i32 @out_of_range_shift(i32 %x) {
; CHECK-LABEL: out_of_range_shift:
; CHECK:       // %bb.0:
; CHECK-NEXT:    mov w0, wzr
; CHECK-NEXT:    ret
