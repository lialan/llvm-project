loop:
  %acc = phi i32 [ 0, %entry ], [ %next, %loop ]
  %t0 = add i32 %acc, 7
  %t1 = add i32 %t0, %a
  %next = add i32 %t1, 9
  %cmp = icmp ult i32 %next, %n
  br i1 %cmp, label %loop, label %exit

exit:
  ret i32 %next
}

