; GFX9-LABEL: fneg_fmed3_0_fmul_user:
; GFX9:       ; %bb.0:
; GFX9-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
; GFX9-NEXT:    v_med3_f32 v0, v0, v1, 0
; GFX9-NEXT:    v_mul_f32_e64 v0, -v0, v2
; GFX9-NEXT:    s_setpc_b64 s[30:31]
;
; GFX11-LABEL: fneg_fmed3_0_fmul_user:
; GFX11:       ; %bb.0:
; GFX11-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
; GFX11-NEXT:    v_med3_f32 v0, -v0, -v1, 0x80000000
; GFX11-NEXT:    s_delay_alu instid0(VALU_DEP_1)
; GFX11-NEXT:    v_mul_f32_e32 v0, v0, v2
; GFX11-NEXT:    s_setpc_b64 s[30:31]
  %med3 = call nnan float @llvm.amdgcn.fmed3.f32(float %a, float %b, float 0.0)
  %neg = fneg float %med3
  %mul = fmul float %neg, %m
  ret float %mul
}

