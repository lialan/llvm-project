    ; CHECK-NEXT: %r:_(i32) = G_AND %x, %c255
    ; CHECK-NEXT: $vgpr0 = COPY %r(i32)
    %x:_(i32) = COPY $vgpr0
    %c255:_(i32) = G_CONSTANT i32 255
    %y:_(i32) = G_SEXT_INREG %x, 8
