; GISEL-NEXT:    add w8, w1, w8
; GISEL-NEXT:    add w0, w8, #16
; GISEL-NEXT:    ret
  %x = add nsw i32 %a, 7
  %x1 = add i32 %x, %b
  %y = add nsw i32 %b, 9
  %r = add i32 %x1, %y
  ret i32 %r
}

define i32 @or_flagged_inner(i32 %a, i32 %b) {
; SDAG-LABEL: or_flagged_inner:
