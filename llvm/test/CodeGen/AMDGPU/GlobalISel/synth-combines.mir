    ; OFF-NEXT: %t1:_(s64) = G_AND %c, %a
    ; OFF-NEXT: %x:_(s64) = G_XOR %t0, %t1
    ; OFF-NEXT: %r:_(s64) = G_MUL %x, %t0
    ; OFF-NEXT: $vgpr0_vgpr1 = COPY %r(s64)
    ; OFF-NEXT: SI_RETURN implicit $vgpr0_vgpr1
    ;
    ; ON-LABEL: name: xor_of_ands_multi_use_no_fold
    ; ON: liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $vgpr4_vgpr5
    ; ON-NEXT: {{  $}}
