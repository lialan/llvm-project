    ; ON-NEXT: %c32:_(s32) = COPY $vgpr2
    ; ON-NEXT: [[OR:%[0-9]+]]:_(s32) = G_OR %c32, %b32
    ; ON-NEXT: [[AND:%[0-9]+]]:_(s32) = G_AND [[OR]], %a32
    ; ON-NEXT: $vgpr0 = COPY [[AND]](s32)
    ; ON-NEXT: SI_RETURN implicit $vgpr0
    %a32:_(s32) = COPY $vgpr0
    %b32:_(s32) = COPY $vgpr1
    %c32:_(s32) = COPY $vgpr2
    %a:_(s16) = G_TRUNC %a32
    %b:_(s16) = G_TRUNC %b32
    %c:_(s16) = G_TRUNC %c32
    %t0:_(s16) = G_AND %b, %a
    %t1:_(s16) = G_AND %a, %c
    %r:_(s16) = G_OR %t0, %t1
    %r32:_(s32) = G_ANYEXT %r(s16)
    $vgpr0 = COPY %r32(s32)
    SI_RETURN implicit $vgpr0
...
