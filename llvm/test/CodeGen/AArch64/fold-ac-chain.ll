; A loop-carried value: the phi is a leaf.
; ((acc + 7) + a) + 9 -> (acc + a) + 16
define i32 @add_phi_cycle(i32 %a, i32 %n) {
; CHECK-LABEL: add_phi_cycle:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    mov w8, wzr
; CHECK-NEXT:  .LBB12_1: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    add w8, w8, w0
; CHECK-NEXT:    add w8, w8, #16
; CHECK-NEXT:    cmp w8, w1
; CHECK-NEXT:    b.lo .LBB12_1
; CHECK-NEXT:  // %bb.2: // %exit
; CHECK-NEXT:    mov w0, w8
; CHECK-NEXT:    ret
entry:
  br label %loop

loop:
  %acc = phi i32 [ 0, %entry ], [ %next, %loop ]
  %t0 = add i32 %acc, 7
  %t1 = add i32 %t0, %a
  %next = add i32 %t1, 9
  %cmp = icmp ult i32 %next, %n
  br i1 %cmp, label %loop, label %exit

exit:
  ret i32 %next
}

