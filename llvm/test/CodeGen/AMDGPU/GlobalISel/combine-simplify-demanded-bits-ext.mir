...

# Only the high part of the concatenation is demanded: the low part is undef.
---
name: lshr_merge_low_undemanded
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: lshr_merge_low_undemanded
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %hi:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:_(i32) = G_IMPLICIT_DEF
    ; CHECK-NEXT: %m:_(i64) = G_MERGE_VALUES [[DEF]](i32), %hi(i32)
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(i32), [[UV1:%[0-9]+]]:_(i32) = G_UNMERGE_VALUES %m(i64)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 8
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(i32) = G_LSHR [[UV1]], [[C]](i32)
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: %r:_(i64) = G_MERGE_VALUES [[LSHR]](i32), [[C1]](i32)
    ; CHECK-NEXT: $vgpr0_vgpr1 = COPY %r(i64)
    %lo:_(i32) = COPY $vgpr0
    %hi:_(i32) = COPY $vgpr1
    %c255:_(i32) = G_CONSTANT i32 255
    %c40:_(i32) = G_CONSTANT i32 40
    %lom:_(i32) = G_AND %lo, %c255
    %m:_(i64) = G_MERGE_VALUES %lom, %hi
    %r:_(i64) = G_LSHR %m, %c40
    $vgpr0_vgpr1 = COPY %r
...

# Negative: without a shift to form an extract with, the narrow AND only trades
# the free any-extension for a zero extension.
---
name: and_anyext_no_shift
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: and_anyext_no_shift
