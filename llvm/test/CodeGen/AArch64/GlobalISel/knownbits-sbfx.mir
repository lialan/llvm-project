# NOTE: Assertions have been autogenerated by utils/update_givaluetracking_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -passes="print<gisel-value-tracking>" -filetype=null %s 2>&1 | FileCheck %s

# The bits above the field of a G_SBFX are copies of its sign bit.
---
name: sbfx
tracksRegLiveness: false
body: |
  bb.0:
  ; CHECK-LABEL: name: @sbfx
  ; CHECK-NEXT: %x:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %pos:_ KnownBits:00000000000000000000000000000100 SignBits:29 IsKnownNeverZero:1
  ; CHECK-NEXT: %width:_ KnownBits:00000000000000000000000000001000 SignBits:28 IsKnownNeverZero:1
  ; CHECK-NEXT: %r:_ KnownBits:???????????????????????????????? SignBits:25 IsKnownNeverZero:0
    %x:_(i32) = COPY $w0
    %pos:_(i32) = G_CONSTANT i32 4
    %width:_(i32) = G_CONSTANT i32 8
    %r:_(i32) = G_SBFX %x, %pos(i32), %width
...
