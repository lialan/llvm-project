    ; ONLY-NEXT: [[ZEXT:%[0-9]+]]:_(s64) = G_ZEXT [[COPY]](i32)
    ; ONLY-NEXT: $vgpr0_vgpr1 = COPY [[ZEXT]](s64)
    %0:_(s32) = COPY $vgpr0
    %1:_(s64) = G_ZEXT %0
    %2:_(s64) = G_CONSTANT i64 4294967295
