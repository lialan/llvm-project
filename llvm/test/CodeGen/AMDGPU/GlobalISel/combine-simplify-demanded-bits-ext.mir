# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# REQUIRES: asserts
# RUN: llc -mtriple=amdgpu11.00-amd-amdhsa -run-pass=amdgpu-postlegalizer-combiner -amdgpupostlegalizercombiner-only-enable-rule=simplify_demanded_bits %s -o - | FileCheck %s

# (and (anyext Y), C) with C inside Y's type is done before the extension.
---
name: and_anyext_lshr
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: and_anyext_lshr
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %c8:_(i32) = G_CONSTANT i32 8
    ; CHECK-NEXT: %s:_(i32) = G_LSHR %x, %c8(i32)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 255
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(i32) = G_AND %s, [[C]]
    ; CHECK-NEXT: %r:_(i64) = G_ZEXT [[AND]](i32)
    ; CHECK-NEXT: $vgpr0_vgpr1 = COPY %r(i64)
    %x:_(i32) = COPY $vgpr0
    %c8:_(i32) = G_CONSTANT i32 8
    %mask:_(i64) = G_CONSTANT i64 255
    %s:_(i32) = G_LSHR %x, %c8
    %e:_(i64) = G_ANYEXT %s
    %r:_(i64) = G_AND %e, %mask
    $vgpr0_vgpr1 = COPY %r
...

# The AND only clears the bits that the extension adds: a zero extension.
---
name: and_anyext_only_clears_high
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: and_anyext_only_clears_high
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %c255:_(i32) = G_CONSTANT i32 255
    ; CHECK-NEXT: %y:_(i32) = G_AND %x, %c255
    ; CHECK-NEXT: %r:_(i64) = G_ZEXT %y(i32)
    ; CHECK-NEXT: $vgpr0_vgpr1 = COPY %r(i64)
    %x:_(i32) = COPY $vgpr0
    %c255:_(i32) = G_CONSTANT i32 255
    %mask:_(i64) = G_CONSTANT i64 4294967295
    %y:_(i32) = G_AND %x, %c255
    %e:_(i64) = G_ANYEXT %y
    %r:_(i64) = G_AND %e, %mask
    $vgpr0_vgpr1 = COPY %r
...

