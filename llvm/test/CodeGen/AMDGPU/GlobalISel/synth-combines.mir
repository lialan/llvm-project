# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1100 -run-pass=amdgpu-prelegalizer-combiner %s -o - | FileCheck --check-prefix=OFF %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1100 -run-pass=amdgpu-prelegalizer-combiner -amdgpu-gisel-synth-combines %s -o - | FileCheck --check-prefix=ON %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1100 -run-pass=amdgpu-prelegalizer-combiner -amdgpu-gisel-synth-combines --amdgpuprelegalizercombiner-disable-rule=redundant_and,redundant_or %s -o - | FileCheck --check-prefix=ONLY %s

# Rules generated by llvm/utils/gisel-rule-synth (gi_synth_combines). They are
# off by default (OFF). The functions use masks, widths and shift amounts that
# are not in the synthesizer's seed corpus, to check that the generalized
# rules apply beyond their training examples. The ONLY run disables the
# hand-written redundant_and / redundant_or so the synthesized known-bits
# rules are seen doing that work alone. In and_or_disjoint_multi_use_keeps_or
# the G_OR has another use; the rewrite still applies because the replacement
# costs no more than the G_AND it replaces.

