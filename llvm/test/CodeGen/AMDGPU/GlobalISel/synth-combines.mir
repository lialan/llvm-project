    ; ON-NEXT: %r:_(s64) = G_SUB %b, %c
    ; ON-NEXT: $vgpr0_vgpr1 = COPY %r(s64)
    ; ON-NEXT: SI_RETURN implicit $vgpr0_vgpr1
    %a:_(s64) = COPY $vgpr0_vgpr1
    %b:_(s64) = COPY $vgpr2_vgpr3
    %c:_(s64) = COPY $vgpr4_vgpr5
