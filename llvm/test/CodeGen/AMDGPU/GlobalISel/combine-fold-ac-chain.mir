    ; CHECK-NEXT: [[BUILD_VECTOR:%[0-9]+]]:_(<2 x s32>) = G_BUILD_VECTOR [[C]](s32), [[C]](s32)
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(<2 x s32>) = G_ADD %a, %b
    ; CHECK-NEXT: %r:_(<2 x s32>) = G_ADD [[ADD]], [[BUILD_VECTOR]]
    ; CHECK-NEXT: $vgpr0_vgpr1 = COPY %r(<2 x s32>)
    %a:_(<2 x s32>) = COPY $vgpr0_vgpr1
    %b:_(<2 x s32>) = COPY $vgpr2_vgpr3
