; By default a value with several uses is a leaf of the chain. With
; -combiner-ac-chain-flatten-shared the walk goes through it, and the inner
; nodes that stay for their other users count against the rewrite.

; Through the shared %s, ((a ^ b) ^ c) ^ a -> b ^ c removes two xors and adds
; one, while %s stays for its other user.
define { i32, i32 } @xor_shared_inner(i32 inreg %a, i32 inreg %b, i32 inreg %c) {
; DEFAULT-LABEL: xor_shared_inner:
; DEFAULT:       ; %bb.0:
; DEFAULT-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
; DEFAULT-NEXT:    s_xor_b32 s1, s0, s1
; DEFAULT-NEXT:    s_delay_alu instid0(SALU_CYCLE_1) | instskip(SKIP_2) | instid1(SALU_CYCLE_1)
; DEFAULT-NEXT:    s_xor_b32 s2, s1, s2
; DEFAULT-NEXT:    v_mov_b32_e32 v1, s1
; DEFAULT-NEXT:    s_xor_b32 s0, s2, s0
; DEFAULT-NEXT:    v_mov_b32_e32 v0, s0
; DEFAULT-NEXT:    s_setpc_b64 s[30:31]
;
; SHARED-LABEL: xor_shared_inner:
; SHARED:       ; %bb.0:
; SHARED-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
; SHARED-NEXT:    s_xor_b32 s2, s1, s2
; SHARED-NEXT:    s_xor_b32 s0, s0, s1
; SHARED-NEXT:    s_delay_alu instid0(SALU_CYCLE_1)
; SHARED-NEXT:    v_dual_mov_b32 v0, s2 :: v_dual_mov_b32 v1, s0
; SHARED-NEXT:    s_setpc_b64 s[30:31]
  %s = xor i32 %a, %b
  %t = xor i32 %s, %c
  %r = xor i32 %t, %a
  %ret0 = insertvalue { i32, i32 } poison, i32 %r, 0
  %ret1 = insertvalue { i32, i32 } %ret0, i32 %s, 1
  ret { i32, i32 } %ret1
}

