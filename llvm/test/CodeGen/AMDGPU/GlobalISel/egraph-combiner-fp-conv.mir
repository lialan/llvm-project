# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn-amd-amdhsa -run-pass=gisel-egraph-combiner -gisel-egraph-mode=rewrite %s -o - | FileCheck %s

# Rewrite mode of the experimental e-graph combiner for the conversions
# between integers and floating-point values, and for G_FREEZE of
# floating-point values.

---
# An s16 has an exact value in a float, so the two conversions give the
# integer again.
name: fptosi_of_sitofp_same
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: fptosi_of_sitofp_same
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %a:_(i16) = G_TRUNC [[COPY]](i32)
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT %a(i16)
    ; CHECK-NEXT: $vgpr0 = COPY [[ANYEXT]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:_(i32) = COPY $vgpr0
    %a:_(i16) = G_TRUNC %0
    %f:_(f32) = G_SITOFP %a
    %r:_(i16) = G_FPTOSI %f
    %e:_(i32) = G_ANYEXT %r
    $vgpr0 = COPY %e
    SI_RETURN implicit $vgpr0
...
---
