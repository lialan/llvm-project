# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu11.00-amd-amdhsa -run-pass=amdgpu-postlegalizer-combiner -amdgpupostlegalizercombiner-only-enable-rule=bitfield_view %s -o - | FileCheck --check-prefixes=CHECK,TRUE16 %s
# RUN: llc -mtriple=amdgpu11.00-amd-amdhsa -mattr=-real-true16 -run-pass=amdgpu-postlegalizer-combiner -amdgpupostlegalizercombiner-only-enable-rule=bitfield_view %s -o - | FileCheck --check-prefixes=CHECK,FAKE16 %s
# REQUIRES: asserts

# After the legalizer, a 16-bit field is not rewritten with new 16-bit
# operations on subtargets with real true16 instructions.
---
name: nested_unsigned_i16
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; TRUE16-LABEL: name: nested_unsigned_i16
    ; TRUE16: liveins: $vgpr0
    ; TRUE16-NEXT: {{  $}}
    ; TRUE16-NEXT: %x32:_(i32) = COPY $vgpr0
    ; TRUE16-NEXT: %x:_(i16) = G_TRUNC %x32(i32)
    ; TRUE16-NEXT: %c4:_(i16) = G_CONSTANT i16 4
    ; TRUE16-NEXT: %c255:_(i16) = G_CONSTANT i16 255
    ; TRUE16-NEXT: %c2:_(i16) = G_CONSTANT i16 2
    ; TRUE16-NEXT: %c15:_(i16) = G_CONSTANT i16 15
    ; TRUE16-NEXT: %a:_(i16) = G_LSHR %x, %c4(i16)
    ; TRUE16-NEXT: %b:_(i16) = G_AND %a, %c255
    ; TRUE16-NEXT: %c:_(i16) = G_LSHR %b, %c2(i16)
    ; TRUE16-NEXT: %d:_(i16) = G_AND %c, %c15
    ; TRUE16-NEXT: %r:_(i32) = G_ANYEXT %d(i16)
    ; TRUE16-NEXT: $vgpr0 = COPY %r(i32)
    ;
    ; FAKE16-LABEL: name: nested_unsigned_i16
    ; FAKE16: liveins: $vgpr0
    ; FAKE16-NEXT: {{  $}}
    ; FAKE16-NEXT: %x32:_(i32) = COPY $vgpr0
    ; FAKE16-NEXT: %x:_(i16) = G_TRUNC %x32(i32)
    ; FAKE16-NEXT: %c15:_(i16) = G_CONSTANT i16 15
    ; FAKE16-NEXT: [[C:%[0-9]+]]:_(i16) = G_CONSTANT i16 6
    ; FAKE16-NEXT: [[LSHR:%[0-9]+]]:_(i16) = G_LSHR %x, [[C]](i16)
    ; FAKE16-NEXT: %d:_(i16) = G_AND [[LSHR]], %c15
    ; FAKE16-NEXT: %r:_(i32) = G_ANYEXT %d(i16)
    ; FAKE16-NEXT: $vgpr0 = COPY %r(i32)
    %x32:_(i32) = COPY $vgpr0
    %x:_(i16) = G_TRUNC %x32
    %c4:_(i16) = G_CONSTANT i16 4
    %c255:_(i16) = G_CONSTANT i16 255
    %c2:_(i16) = G_CONSTANT i16 2
    %c15:_(i16) = G_CONSTANT i16 15
    %a:_(i16) = G_LSHR %x, %c4
    %b:_(i16) = G_AND %a, %c255
    %c:_(i16) = G_LSHR %b, %c2
    %d:_(i16) = G_AND %c, %c15
    %r:_(i32) = G_ANYEXT %d
    $vgpr0 = COPY %r
...

# A 32-bit field is rewritten either way.
---
name: nested_unsigned_i32
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: nested_unsigned_i32
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 6
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 4
    ; CHECK-NEXT: %d:_(i32) = G_UBFX %x, [[C]](i32), [[C1]]
    ; CHECK-NEXT: $vgpr0 = COPY %d(i32)
    %x:_(i32) = COPY $vgpr0
    %c4:_(i32) = G_CONSTANT i32 4
    %c255:_(i32) = G_CONSTANT i32 255
    %c2:_(i32) = G_CONSTANT i32 2
    %c15:_(i32) = G_CONSTANT i32 15
    %a:_(i32) = G_LSHR %x, %c4
    %b:_(i32) = G_AND %a, %c255
    %c:_(i32) = G_LSHR %b, %c2
    %d:_(i32) = G_AND %c, %c15
    $vgpr0 = COPY %d
...
