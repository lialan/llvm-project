; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=amdgpu9.50 -verify-machineinstrs < %s | FileCheck %s

; Clearing undemanded low bits in the operand masks would require two more
; 32-bit ANDs before the 64-bit comparison.
define i64 @smin_i64_keep_operand_masks(i64 %x, i64 %y) {
; CHECK-LABEL: smin_i64_keep_operand_masks:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
; CHECK-NEXT:    v_and_b32_e32 v1, 0x7fffffff, v1
; CHECK-NEXT:    v_and_b32_e32 v3, 0x3fffffff, v3
; CHECK-NEXT:    v_cmp_lt_i64_e32 vcc, v[0:1], v[2:3]
; CHECK-NEXT:    v_mov_b32_e32 v1, 0
; CHECK-NEXT:    s_nop 0
; CHECK-NEXT:    v_cndmask_b32_e32 v0, v2, v0, vcc
; CHECK-NEXT:    v_and_b32_e32 v0, 0x10000, v0
; CHECK-NEXT:    s_setpc_b64 s[30:31]
  %a = and i64 %x, 9223372036854775807
  %b = and i64 %y, 4611686018427387903
  %m = call i64 @llvm.smin.i64(i64 %a, i64 %b)
  %r = and i64 %m, 65536
  ret i64 %r
}

; Keep the byte masks introduced during legalization so SDWA can fold them.
define i8 @umax_i8_keep_operand_masks(i8 %x, i8 %y) {
; CHECK-LABEL: umax_i8_keep_operand_masks:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
; CHECK-NEXT:    v_add_u16_e32 v0, 2, v0
; CHECK-NEXT:    v_add_u16_e32 v1, 1, v1
; CHECK-NEXT:    v_max_u16_sdwa v0, v0, v1 dst_sel:DWORD dst_unused:UNUSED_PAD src0_sel:BYTE_0 src1_sel:BYTE_0
; CHECK-NEXT:    v_and_b32_e32 v0, 4, v0
; CHECK-NEXT:    s_setpc_b64 s[30:31]
  %a = add i8 %x, 2
  %b = add i8 %y, 1
  %m = call i8 @llvm.umax.i8(i8 %a, i8 %b)
  %r = and i8 %m, 4
  ret i8 %r
}

; Bitwise operations that only change undemanded low bits can still be removed.
define i32 @umin_i32_low_bit_ops(i32 %x, i32 %y) {
; CHECK-LABEL: umin_i32_low_bit_ops:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
; CHECK-NEXT:    v_min_u32_e32 v0, v0, v1
; CHECK-NEXT:    v_lshrrev_b32_e32 v0, 7, v0
; CHECK-NEXT:    s_setpc_b64 s[30:31]
  %a = or i32 %x, 127
  %b = and i32 %y, -128
  %m = call i32 @llvm.umin.i32(i32 %a, i32 %b)
  %r = lshr i32 %m, 7
  ret i32 %r
}

; Keep the XOR shared between the min and the store.
define i32 @umin_i32_shared_operand(i32 %x, i32 %y, ptr addrspace(1) %out) {
; CHECK-LABEL: umin_i32_shared_operand:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
; CHECK-NEXT:    v_xor_b32_e32 v0, 0x80, v0
; CHECK-NEXT:    v_min_u32_e32 v1, v0, v1
; CHECK-NEXT:    global_store_dword v[2:3], v0, off
; CHECK-NEXT:    v_lshrrev_b32_e32 v0, 8, v1
; CHECK-NEXT:    s_waitcnt vmcnt(0)
; CHECK-NEXT:    s_setpc_b64 s[30:31]
  %a = xor i32 %x, 128
  %m = call i32 @llvm.umin.i32(i32 %a, i32 %y)
  store i32 %a, ptr addrspace(1) %out
  %r = lshr i32 %m, 8
  ret i32 %r
}

declare i64 @llvm.smin.i64(i64, i64)
declare i8 @llvm.umax.i8(i8, i8)
declare i32 @llvm.umin.i32(i32, i32)
