# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn-amd-amdhsa -run-pass=gisel-egraph-combiner -gisel-egraph-mode=rewrite %s -o - | FileCheck %s

# Rewrite mode of the experimental e-graph combiner for the operators that are
# not binary operations of one type: casts, comparisons, selects, division,
# bit operations, pointer arithmetic, PHIs and conditional branches.

---
# zext(zext(a)) ==> zext(a), and trunc(zext(a)) to the type of a ==> a.
name: casts_compose
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: casts_compose
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: [[SEXT_INREG:%[0-9]+]]:_(s32) = G_SEXT_INREG %x, 8
    ; CHECK-NEXT: $vgpr0 = COPY [[SEXT_INREG]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %x:_(s32) = COPY $vgpr0
    %a:_(s8) = G_TRUNC %x
    %z1:_(s16) = G_ZEXT %a
    %z2:_(s64) = G_ZEXT %z1
    %t:_(s8) = G_TRUNC %z2
    %r:_(s32) = G_SEXT %t
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# zext(a) & zext(b) ==> zext(a & b)
name: hoist_zext
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: hoist_zext
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %y:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(s32) = G_AND %x, %y
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(s16) = G_TRUNC [[AND]](s32)
    ; CHECK-NEXT: [[ZEXT:%[0-9]+]]:_(s64) = G_ZEXT [[TRUNC]](s16)
    ; CHECK-NEXT: $vgpr0_vgpr1 = COPY [[ZEXT]](s64)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0_vgpr1
    %x:_(s32) = COPY $vgpr0
    %y:_(s32) = COPY $vgpr1
    %a:_(s16) = G_TRUNC %x
    %b:_(s16) = G_TRUNC %y
    %za:_(s64) = G_ZEXT %a
    %zb:_(s64) = G_ZEXT %b
    %r:_(s64) = G_AND %za, %zb
    $vgpr0_vgpr1 = COPY %r
    SI_RETURN implicit $vgpr0_vgpr1
...
---
# ctpop(bswap(a)) ==> ctpop(a), and bitreverse(bitreverse(b)) ==> b.
name: bit_operations
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: bit_operations
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: [[CTPOP:%[0-9]+]]:_(s32) = G_CTPOP %a(s32)
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(s32) = G_ADD [[CTPOP]], %b
    ; CHECK-NEXT: $vgpr0 = COPY [[ADD]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %s:_(s32) = G_BSWAP %a
    %p:_(s32) = G_CTPOP %s
    %r1:_(s32) = G_BITREVERSE %b
    %r2:_(s32) = G_BITREVERSE %r1
    %r:_(s32) = G_ADD %p, %r2
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# !(a u< b) ==> a u>= b
name: not_of_icmp
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: not_of_icmp
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:_(s1) = G_ICMP intpred(uge), %a(s32), %b
    ; CHECK-NEXT: [[ZEXT:%[0-9]+]]:_(s32) = G_ZEXT [[ICMP]](s1)
    ; CHECK-NEXT: $vgpr0 = COPY [[ZEXT]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c:_(s1) = G_ICMP intpred(ult), %a, %b
    %true:_(s1) = G_CONSTANT i1 true
    %n:_(s1) = G_XOR %c, %true
    %r:_(s32) = G_ZEXT %n
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# select(!c, a, b) ==> select(c, b, a)
