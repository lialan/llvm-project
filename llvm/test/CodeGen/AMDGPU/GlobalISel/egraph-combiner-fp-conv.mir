tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: fptosi_of_sitofp_not_exact
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %f:_(f32) = G_SITOFP %a(i32)
    ; CHECK-NEXT: %r:_(i32) = G_FPTOSI %f(f32)
    ; CHECK-NEXT: $vgpr0 = COPY %r(i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(i32) = COPY $vgpr0
    %f:_(f32) = G_SITOFP %a
    %r:_(i32) = G_FPTOSI %f
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# The first conversion is not exact, but an integer that the float does not
# have is outside of the range of an s16, where G_FPTOSI gives poison.
name: fptosi_of_sitofp_narrow
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: fptosi_of_sitofp_narrow
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(i16) = G_TRUNC %a(i32)
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT [[TRUNC]](i16)
    ; CHECK-NEXT: $vgpr0 = COPY [[ANYEXT]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(i32) = COPY $vgpr0
    %f:_(f32) = G_SITOFP %a
    %r:_(i16) = G_FPTOSI %f
    %e:_(i32) = G_ANYEXT %r
    $vgpr0 = COPY %e
    SI_RETURN implicit $vgpr0
...
---
