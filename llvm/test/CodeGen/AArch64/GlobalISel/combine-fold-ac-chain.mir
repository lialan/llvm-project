# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=aarch64-prelegalizer-combiner -aarch64prelegalizercombiner-only-enable-rule="fold_ac_chain" %s -o - | FileCheck %s
# REQUIRES: asserts

# The constants are added modulo 2^64: (a + -1) + (b + 2) -> (a + b) + 1
---
name: add_constants_wrap_s64
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0, $x1
    ; CHECK-LABEL: name: add_constants_wrap_s64
    ; CHECK: liveins: $x0, $x1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s64) = COPY $x0
    ; CHECK-NEXT: %b:_(s64) = COPY $x1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s64) = G_CONSTANT i64 1
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(s64) = G_ADD %a, %b
    ; CHECK-NEXT: %r:_(s64) = G_ADD [[ADD]], [[C]]
    ; CHECK-NEXT: $x0 = COPY %r(s64)
    ; CHECK-NEXT: RET_ReallyLR implicit $x0
    %a:_(s64) = COPY $x0
    %b:_(s64) = COPY $x1
    %cm1:_(s64) = G_CONSTANT i64 -1
    %c2:_(s64) = G_CONSTANT i64 2
    %x:_(s64) = G_ADD %a, %cm1
    %y:_(s64) = G_ADD %b, %c2
    %r:_(s64) = G_ADD %x, %y
    $x0 = COPY %r
    RET_ReallyLR implicit $x0
...

# ((a + a) + (a + a)) -> a << 2
---
name: add_leaf_four_times
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: add_leaf_four_times
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $w0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 2
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(s32) = G_SHL %a, [[C]](s32)
    ; CHECK-NEXT: %r:_(s32) = COPY [[SHL]](s32)
    ; CHECK-NEXT: $w0 = COPY %r(s32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %a:_(s32) = COPY $w0
    %x:_(s32) = G_ADD %a, %a
    %y:_(s32) = G_ADD %a, %a
    %r:_(s32) = G_ADD %x, %y
    $w0 = COPY %r
    RET_ReallyLR implicit $w0
...

# (a ^ b) ^ (a ^ c) -> b ^ c
---
name: xor_cancel
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0, $w1, $w2
    ; CHECK-LABEL: name: xor_cancel
    ; CHECK: liveins: $w0, $w1, $w2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %b:_(s32) = COPY $w1
    ; CHECK-NEXT: %c:_(s32) = COPY $w2
    ; CHECK-NEXT: %r:_(s32) = G_XOR %b, %c
    ; CHECK-NEXT: $w0 = COPY %r(s32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %a:_(s32) = COPY $w0
    %b:_(s32) = COPY $w1
    %c:_(s32) = COPY $w2
    %x:_(s32) = G_XOR %a, %b
    %y:_(s32) = G_XOR %a, %c
    %r:_(s32) = G_XOR %x, %y
    $w0 = COPY %r
    RET_ReallyLR implicit $w0
...

# ((a & 0xff) & b) & (a & 0xf0) -> (a & b) & 0xf0, on vectors.
---
name: and_dedup_masks_v4s32
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $q0, $q1
    ; CHECK-LABEL: name: and_dedup_masks_v4s32
    ; CHECK: liveins: $q0, $q1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(<4 x s32>) = COPY $q0
    ; CHECK-NEXT: %b:_(<4 x s32>) = COPY $q1
    ; CHECK-NEXT: %f0:_(s32) = G_CONSTANT i32 240
    ; CHECK-NEXT: %cf0:_(<4 x s32>) = G_BUILD_VECTOR %f0(s32), %f0(s32), %f0(s32), %f0(s32)
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(<4 x s32>) = G_AND %a, %b
    ; CHECK-NEXT: %r:_(<4 x s32>) = G_AND [[AND]], %cf0
    ; CHECK-NEXT: $q0 = COPY %r(<4 x s32>)
    ; CHECK-NEXT: RET_ReallyLR implicit $q0
    %a:_(<4 x s32>) = COPY $q0
    %b:_(<4 x s32>) = COPY $q1
    %ff:_(s32) = G_CONSTANT i32 255
    %f0:_(s32) = G_CONSTANT i32 240
    %cff:_(<4 x s32>) = G_BUILD_VECTOR %ff, %ff, %ff, %ff
    %cf0:_(<4 x s32>) = G_BUILD_VECTOR %f0, %f0, %f0, %f0
    %x:_(<4 x s32>) = G_AND %a, %cff
    %y:_(<4 x s32>) = G_AND %x, %b
    %z:_(<4 x s32>) = G_AND %a, %cf0
    %r:_(<4 x s32>) = G_AND %y, %z
    $q0 = COPY %r
    RET_ReallyLR implicit $q0
...

# ((a | 1) | b) | (a | 2) -> (a | b) | 3
---
name: or_dedup_masks
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0, $w1
    ; CHECK-LABEL: name: or_dedup_masks
    ; CHECK: liveins: $w0, $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $w0
    ; CHECK-NEXT: %b:_(s32) = COPY $w1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 3
    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(s32) = G_OR %a, %b
    ; CHECK-NEXT: %r:_(s32) = G_OR [[OR]], [[C]]
    ; CHECK-NEXT: $w0 = COPY %r(s32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %a:_(s32) = COPY $w0
    %b:_(s32) = COPY $w1
    %c1:_(s32) = G_CONSTANT i32 1
    %c2:_(s32) = G_CONSTANT i32 2
    %x:_(s32) = G_OR %a, %c1
    %y:_(s32) = G_OR %x, %b
    %z:_(s32) = G_OR %a, %c2
    %r:_(s32) = G_OR %y, %z
    $w0 = COPY %r
    RET_ReallyLR implicit $w0
...

# A flagged inner node is a leaf: (a +nsw 7) + 9 is not regrouped.
---
name: add_flagged_inner
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: add_flagged_inner
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $w0
    ; CHECK-NEXT: %c7:_(s32) = G_CONSTANT i32 7
    ; CHECK-NEXT: %c9:_(s32) = G_CONSTANT i32 9
    ; CHECK-NEXT: %x:_(s32) = nsw G_ADD %a, %c7
    ; CHECK-NEXT: %y:_(s32) = G_ADD %x, %c9
    ; CHECK-NEXT: %r:_(s32) = G_ADD %y, %a
    ; CHECK-NEXT: $w0 = COPY %r(s32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %a:_(s32) = COPY $w0
    %c7:_(s32) = G_CONSTANT i32 7
    %c9:_(s32) = G_CONSTANT i32 9
    %x:_(s32) = nsw G_ADD %a, %c7
    %y:_(s32) = G_ADD %x, %c9
    %r:_(s32) = G_ADD %y, %a
    $w0 = COPY %r
    RET_ReallyLR implicit $w0
...

# A loop-carried value: the G_PHI is a leaf and the walk stops there.
# ((acc ^ 7) ^ a) ^ 9 -> (acc ^ a) ^ 14
---
name: xor_phi_cycle
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: xor_phi_cycle
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $w0, $w1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %a:_(s32) = COPY $w0
  ; CHECK-NEXT:   %n:_(s32) = COPY $w1
  ; CHECK-NEXT:   %zero:_(s32) = G_CONSTANT i32 0
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %acc:_(s32) = G_PHI %zero(s32), %bb.0, %next(s32), %bb.1
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 14
  ; CHECK-NEXT:   [[XOR:%[0-9]+]]:_(s32) = G_XOR %acc, %a
  ; CHECK-NEXT:   %next:_(s32) = G_XOR [[XOR]], [[C]]
  ; CHECK-NEXT:   %cmp:_(s1) = G_ICMP intpred(ult), %next(s32), %n
  ; CHECK-NEXT:   G_BRCOND %cmp(s1), %bb.1
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $w0 = COPY %next(s32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    successors: %bb.1
    liveins: $w0, $w1
    %a:_(s32) = COPY $w0
    %n:_(s32) = COPY $w1
    %zero:_(s32) = G_CONSTANT i32 0
    %c7:_(s32) = G_CONSTANT i32 7
    %c9:_(s32) = G_CONSTANT i32 9
    G_BR %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    %acc:_(s32) = G_PHI %zero(s32), %bb.0, %next(s32), %bb.1
    %t0:_(s32) = G_XOR %acc, %c7
    %t1:_(s32) = G_XOR %t0, %a
    %next:_(s32) = G_XOR %t1, %c9
    %cmp:_(s1) = G_ICMP intpred(ult), %next(s32), %n
    G_BRCOND %cmp(s1), %bb.1
    G_BR %bb.2

  bb.2:
    $w0 = COPY %next
    RET_ReallyLR implicit $w0
...

# Nine leaves are over the budget: nothing changes.
---
name: add_nine_leaves
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0, $w1, $w2, $w3, $w4, $w5, $w6
    ; CHECK-LABEL: name: add_nine_leaves
    ; CHECK: liveins: $w0, $w1, $w2, $w3, $w4, $w5, $w6
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $w0
    ; CHECK-NEXT: %b:_(s32) = COPY $w1
    ; CHECK-NEXT: %c:_(s32) = COPY $w2
    ; CHECK-NEXT: %d:_(s32) = COPY $w3
    ; CHECK-NEXT: %e:_(s32) = COPY $w4
    ; CHECK-NEXT: %f:_(s32) = COPY $w5
    ; CHECK-NEXT: %g:_(s32) = COPY $w6
    ; CHECK-NEXT: %c1:_(s32) = G_CONSTANT i32 1
    ; CHECK-NEXT: %c2:_(s32) = G_CONSTANT i32 2
    ; CHECK-NEXT: %s0:_(s32) = G_ADD %a, %c1
    ; CHECK-NEXT: %s1:_(s32) = G_ADD %s0, %b
    ; CHECK-NEXT: %s2:_(s32) = G_ADD %s1, %c
    ; CHECK-NEXT: %s3:_(s32) = G_ADD %s2, %d
    ; CHECK-NEXT: %s4:_(s32) = G_ADD %s3, %e
    ; CHECK-NEXT: %s5:_(s32) = G_ADD %s4, %f
    ; CHECK-NEXT: %s6:_(s32) = G_ADD %s5, %g
    ; CHECK-NEXT: %r:_(s32) = G_ADD %s6, %c2
    ; CHECK-NEXT: $w0 = COPY %r(s32)
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %a:_(s32) = COPY $w0
    %b:_(s32) = COPY $w1
    %c:_(s32) = COPY $w2
    %d:_(s32) = COPY $w3
    %e:_(s32) = COPY $w4
    %f:_(s32) = COPY $w5
    %g:_(s32) = COPY $w6
    %c1:_(s32) = G_CONSTANT i32 1
    %c2:_(s32) = G_CONSTANT i32 2
    %s0:_(s32) = G_ADD %a, %c1
    %s1:_(s32) = G_ADD %s0, %b
    %s2:_(s32) = G_ADD %s1, %c
    %s3:_(s32) = G_ADD %s2, %d
    %s4:_(s32) = G_ADD %s3, %e
    %s5:_(s32) = G_ADD %s4, %f
    %s6:_(s32) = G_ADD %s5, %g
    %r:_(s32) = G_ADD %s6, %c2
    $w0 = COPY %r
    RET_ReallyLR implicit $w0
...
