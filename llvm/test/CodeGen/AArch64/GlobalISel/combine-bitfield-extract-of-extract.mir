# REQUIRES: asserts
# RUN: llc -mtriple aarch64 -run-pass=aarch64-postlegalizer-combiner --aarch64postlegalizercombiner-only-enable-rule=bitfield_extract_of_extract,bitfield_extract_from_and_of_trunc %s -o - | FileCheck %s

---
name: ashr_sext_inreg_shl
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: ashr_sext_inreg_shl
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $w0
    ; CHECK-NEXT: %r:_(i32) = G_SEXT_INREG %x, 12
    ; CHECK-NEXT: $w0 = COPY %r(i32)
    %x:_(i32) = COPY $w0
    %c4:_(i32) = G_CONSTANT i32 4
    %shl:_(i32) = G_SHL %x, %c4
    %sext:_(i32) = G_SEXT_INREG %shl, 16
    %r:_(i32) = G_ASHR %sext, %c4
    $w0 = COPY %r
...

