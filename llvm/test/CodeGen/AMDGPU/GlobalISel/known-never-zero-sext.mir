  ; CHECK-NEXT: %zero:_ KnownBits:0000000000000000 SignBits:16 IsKnownNeverZero:0
  ; CHECK-NEXT: %one:_ KnownBits:0000000000000001 SignBits:15 IsKnownNeverZero:1
  ; CHECK-NEXT: %two:_ KnownBits:0000000000000010 SignBits:14 IsKnownNeverZero:1
