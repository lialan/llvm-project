name: known_never_zero_mul
body: |
  bb.0:
  ; CHECK-LABEL: name: @known_never_zero_mul
  ; CHECK-NEXT: %one:_ KnownBits:00000000000000000000000000000001 SignBits:31 IsKnownNeverZero:1
  ; CHECK-NEXT: %two:_ KnownBits:00000000000000000000000000000010 SignBits:30 IsKnownNeverZero:1
  ; CHECK-NEXT: %unknown0:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %unknown1:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %nonzero0:_ KnownBits:???????????????????????????????1 SignBits:1 IsKnownNeverZero:1
