...

# On the bits of its field, a G_UBFX is a right shift.
---
name: and_ubfx
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: and_ubfx
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %c4:_(i32) = G_CONSTANT i32 4
    ; CHECK-NEXT: %c15:_(i32) = G_CONSTANT i32 15
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(i32) = G_LSHR %x, %c4(i32)
    ; CHECK-NEXT: %r:_(i32) = G_AND [[LSHR]], %c15
    ; CHECK-NEXT: $vgpr0 = COPY %r(i32)
    %x:_(i32) = COPY $vgpr0
    %c4:_(i32) = G_CONSTANT i32 4
    %c8:_(i32) = G_CONSTANT i32 8
    %c15:_(i32) = G_CONSTANT i32 15
    %u:_(i32) = G_UBFX %x, %c4, %c8
    %r:_(i32) = G_AND %u, %c15
    $vgpr0 = COPY %r
...

