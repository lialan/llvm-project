    ; CHECK-NEXT: %y:_(s32) = G_ADD %x, %c9
    ; CHECK-NEXT: %r:_(s32) = G_ADD %y, %a
    ; CHECK-NEXT: $vgpr0 = COPY %r(s32)
    %a:_(s32) = COPY $vgpr0
