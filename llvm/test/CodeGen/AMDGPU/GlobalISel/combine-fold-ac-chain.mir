    %c2:_(s32) = G_CONSTANT i32 2
    %v1:_(<2 x s32>) = G_BUILD_VECTOR %c1, %c1
    %v2:_(<2 x s32>) = G_BUILD_VECTOR %c2, %c2
    %x:_(<2 x s32>) = G_ADD %a, %v1
    %y:_(<2 x s32>) = G_ADD %b, %v2
    %r:_(<2 x s32>) = G_ADD %x, %y
    $vgpr0_vgpr1 = COPY %r
...

# (a ^ b) ^ (a ^ c) -> b ^ c
---
name: xor_cancel
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-LABEL: name: xor_cancel
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
