    %bit:gpr(s64) = G_CONSTANT i64 2
    %zero:gpr(s64) = G_CONSTANT i64 0
    %and:gpr(s64) = G_AND %ubfx, %bit
    %cmp:gpr(s32) = G_ICMP intpred(ne), %and(s64), %zero
