  ; CHECK-NEXT: %selected_may_zero:_ KnownBits:00000000000000?0 SignBits:14 IsKnownNeverZero:0
  ; CHECK-NEXT: %sext_nonzero:_ KnownBits:000000000000000000000000000000?? SignBits:30 IsKnownNeverZero:1
  ; CHECK-NEXT: %sext_may_zero:_ KnownBits:000000000000000000000000000000?0 SignBits:30 IsKnownNeverZero:0
    %cond:_(s1) = G_IMPLICIT_DEF
    %zero:_(s16) = G_CONSTANT i16 0
    %one:_(s16) = G_CONSTANT i16 1
    %two:_(s16) = G_CONSTANT i16 2
    %selected_nonzero:_(s16) = G_SELECT %cond, %one, %two
    %selected_may_zero:_(s16) = G_SELECT %cond, %zero, %two
    %sext_nonzero:_(s32) = G_SEXT %selected_nonzero
    %sext_may_zero:_(s32) = G_SEXT %selected_may_zero
