; Chains of the same associative and commutative operation, rebuilt with
; their constants folded and their repeated operands merged, deduplicated or
; cancelled.

; (a + 7) + (b + 9) -> (a + b) + 16
define i32 @add_constants(i32 %a, i32 %b) {
; SDAG-LABEL: add_constants:
; SDAG:       // %bb.0:
; SDAG-NEXT:    add w8, w0, w1
; SDAG-NEXT:    add w0, w8, #16
; SDAG-NEXT:    ret
;
; GISEL-LABEL: add_constants:
; GISEL:       // %bb.0:
; GISEL-NEXT:    add w8, w1, w0
; GISEL-NEXT:    add w0, w8, #16
; GISEL-NEXT:    ret
  %x = add i32 %a, 7
  %y = add i32 %b, 9
  %r = add i32 %x, %y
  ret i32 %r
}

