; CHECK-NEXT:    addu $3, $4, $3
; CHECK-NEXT:    dsll $3, $3, 32
; CHECK-NEXT:    dsrl $3, $3, 32
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    or $3, $3, $1
  %x.hi = lshr <4 x i64> %x, splat (i64 32)
  %x.trunc = trunc <4 x i64> %x.hi to <4 x i32>
  %sra = ashr <4 x i32> %x.trunc, splat (i32 3)
  %y.hi = lshr <4 x i64> %y, splat (i64 32)
  %y.trunc = trunc <4 x i64> %y.hi to <4 x i32>
