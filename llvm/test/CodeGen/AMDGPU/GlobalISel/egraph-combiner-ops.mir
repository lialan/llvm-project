    %x:_(s32) = COPY $vgpr0
    %a:_(s32) = COPY $vgpr1
    %b:_(s32) = COPY $vgpr2
    %c:_(s1) = G_TRUNC %x
    %true:_(s1) = G_CONSTANT i1 true
    %n:_(s1) = G_XOR %c, %true
    %r:_(s32) = G_SELECT %n, %a, %b
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# (select c, 1, 2) + 10 ==> select c, 11, 12
name: fold_through_select
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: fold_through_select
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
