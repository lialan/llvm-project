# Seed corpus for llvm/utils/gisel-rule-synth.
#
# These are *inputs* to rule discovery, not rules: small gMIR functions whose
# values have known bits that GISelValueTracking can establish (zext, constant
# shifts, constant masks). The synthesizer discovers cheaper replacements and
# their preconditions on its own; nothing here says what the replacement is.
# Held-out examples for generalization tests live in
# llvm/test/CodeGen/AMDGPU/GlobalISel/synth-combines.mir, not here.
--- |
  define void @and_zext_mask() { ret void }
  define void @and_lshr_mask() { ret void }
  define void @and_or_disjoint() { ret void }
  define void @and_shl_mask() { ret void }
  define void @or_known_ones() { ret void }
  define void @add_disjoint() { ret void }
  define void @lshr_zext() { ret void }
  define void @absorb() { ret void }
  define void @bitwise_mix() { ret void }
  define void @arith_mix() { ret void }
  define void @casts() { ret void }
  define void @shifts() { ret void }
...
---
name: and_zext_mask
legalized: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    %0:_(s32) = COPY $vgpr0
    %1:_(s8) = G_TRUNC %0
    %2:_(s32) = G_ZEXT %1
    %3:_(s32) = G_CONSTANT i32 255
    %4:_(s32) = G_AND %2, %3
    $vgpr0 = COPY %4
...
---
name: and_lshr_mask
legalized: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = G_CONSTANT i32 16
    %2:_(s32) = G_LSHR %0, %1
    %3:_(s32) = G_CONSTANT i32 65535
    %4:_(s32) = G_AND %2, %3
    $vgpr0 = COPY %4
...
---
name: and_or_disjoint
legalized: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = COPY $vgpr1
    %2:_(s32) = G_CONSTANT i32 8
    %3:_(s32) = G_SHL %1, %2
    %4:_(s32) = G_OR %0, %3
    %5:_(s32) = G_CONSTANT i32 255
    %6:_(s32) = G_AND %4, %5
    $vgpr0 = COPY %6
...
---
name: and_shl_mask
legalized: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = G_CONSTANT i32 8
    %2:_(s32) = G_SHL %0, %1
    %3:_(s32) = G_CONSTANT i32 255
    %4:_(s32) = G_AND %2, %3
    $vgpr0 = COPY %4
...
---
name: or_known_ones
legalized: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = G_CONSTANT i32 15
    %2:_(s32) = G_OR %0, %1
    %3:_(s32) = G_CONSTANT i32 3
    %4:_(s32) = G_OR %2, %3
    %5:_(s32) = G_AND %2, %3
    $vgpr0 = COPY %4
    $vgpr1 = COPY %5
...
---
name: add_disjoint
legalized: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = COPY $vgpr1
    %2:_(s32) = G_CONSTANT i32 4
    %3:_(s32) = G_SHL %0, %2
    %4:_(s32) = G_CONSTANT i32 7
    %5:_(s32) = G_ADD %3, %4
    %6:_(s32) = G_CONSTANT i32 16
    %7:_(s32) = G_LSHR %1, %6
    %8:_(s32) = G_SHL %1, %6
    %9:_(s32) = G_ADD %7, %8
    %10:_(s32) = G_XOR %3, %4
    $vgpr0 = COPY %5
    $vgpr1 = COPY %9
    $vgpr2 = COPY %10
...
---
name: lshr_zext
legalized: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    %0:_(s32) = COPY $vgpr0
    %1:_(s16) = G_TRUNC %0
    %2:_(s32) = G_ZEXT %1
    %3:_(s32) = G_CONSTANT i32 16
    %4:_(s32) = G_LSHR %2, %3
    %5:_(s32) = G_ASHR %2, %3
    $vgpr0 = COPY %4
    $vgpr1 = COPY %5
...
---
name: absorb
legalized: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = COPY $vgpr1
    %2:_(s32) = G_AND %0, %1
    %3:_(s32) = G_OR %0, %2
    %4:_(s32) = G_OR %0, %1
    %5:_(s32) = G_AND %4, %0
    $vgpr0 = COPY %3
    $vgpr1 = COPY %5
...
---
name: bitwise_mix
legalized: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = COPY $vgpr1
    %2:_(s32) = G_OR %0, %1
    %3:_(s32) = G_AND %0, %1
    %4:_(s32) = G_XOR %2, %3
    %5:_(s32) = G_XOR %0, %1
    %6:_(s32) = G_OR %0, %5
    $vgpr0 = COPY %4
    $vgpr1 = COPY %6
...
---
name: arith_mix
legalized: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = COPY $vgpr1
    %2:_(s32) = G_OR %0, %1
    %3:_(s32) = G_AND %0, %1
    %4:_(s32) = G_ADD %2, %3
    %5:_(s32) = G_SUB %2, %3
    $vgpr0 = COPY %4
    $vgpr1 = COPY %5
...
---
name: casts
legalized: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    %0:_(s32) = COPY $vgpr0
    %1:_(s8) = G_TRUNC %0
    %2:_(s32) = G_SEXT %1
    %3:_(s32) = G_CONSTANT i32 255
    %4:_(s32) = G_AND %2, %3
    %5:_(s16) = G_TRUNC %0
    %6:_(s16) = G_CONSTANT i16 255
    %7:_(s16) = G_AND %5, %6
    %8:_(s32) = G_AND %0, %3
    %9:_(s8) = G_TRUNC %8
    $vgpr0 = COPY %4
    %10:_(s32) = G_ANYEXT %7
    $vgpr1 = COPY %10
    %11:_(s32) = G_ANYEXT %9
    $vgpr2 = COPY %11
...
---
name: shifts
legalized: false
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = G_CONSTANT i32 1
    %2:_(s32) = G_LSHR %0, %1
    %3:_(s32) = G_CONSTANT i32 3
    %4:_(s32) = G_ASHR %2, %3
    %5:_(s32) = G_CONSTANT i32 24
    %6:_(s32) = G_SHL %0, %5
    %7:_(s32) = G_LSHR %6, %5
    %8:_(s32) = G_CONSTANT i32 255
    %9:_(s32) = G_AND %0, %8
    %10:_(s32) = G_SHL %9, %5
    %11:_(s32) = G_LSHR %10, %5
    $vgpr0 = COPY %4
    $vgpr1 = COPY %7
    $vgpr2 = COPY %11
...
