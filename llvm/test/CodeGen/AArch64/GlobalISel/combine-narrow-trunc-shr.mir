    ; ISO-NEXT: [[TRUNC:%[0-9]+]]:_(s32) = G_TRUNC [[LSHR]](s64)
    ; ISO-NEXT: $w0 = COPY [[TRUNC]](s32)
    ; ISO-NEXT: RET_ReallyLR implicit $w0
    ;
