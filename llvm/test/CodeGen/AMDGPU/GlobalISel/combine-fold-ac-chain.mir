    ; CHECK-NEXT: %c1:_(s32) = G_CONSTANT i32 1
    ; CHECK-NEXT: %c2:_(s32) = G_CONSTANT i32 2
    ; CHECK-NEXT: %s0:_(s32) = G_ADD %a, %c1
    ; CHECK-NEXT: %s1:_(s32) = G_ADD %s0, %b
    ; CHECK-NEXT: %s2:_(s32) = G_ADD %s1, %c
    ; CHECK-NEXT: %s3:_(s32) = G_ADD %s2, %d
    ; CHECK-NEXT: %s4:_(s32) = G_ADD %s3, %e
    ; CHECK-NEXT: %s5:_(s32) = G_ADD %s4, %f
    ; CHECK-NEXT: %s6:_(s32) = G_ADD %s5, %g
    ; CHECK-NEXT: %r:_(s32) = G_ADD %s6, %c2
    ; CHECK-NEXT: $vgpr0 = COPY %r(s32)
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c:_(s32) = COPY $vgpr2
    %d:_(s32) = COPY $vgpr3
    %e:_(s32) = COPY $vgpr4
    %f:_(s32) = COPY $vgpr5
    %g:_(s32) = COPY $vgpr6
    %c1:_(s32) = G_CONSTANT i32 1
    %c2:_(s32) = G_CONSTANT i32 2
    %s0:_(s32) = G_ADD %a, %c1
    %s1:_(s32) = G_ADD %s0, %b
    %s2:_(s32) = G_ADD %s1, %c
    %s3:_(s32) = G_ADD %s2, %d
    %s4:_(s32) = G_ADD %s3, %e
    %s5:_(s32) = G_ADD %s4, %f
    %s6:_(s32) = G_ADD %s5, %g
    %r:_(s32) = G_ADD %s6, %c2
    $vgpr0 = COPY %r
...
