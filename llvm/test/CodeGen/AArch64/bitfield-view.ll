  %b = and i32 %a, 255
  %c = lshr i32 %b, 40
  %d = and i32 %c, 15
  ret i32 %d
}

; Bits [28, 36) of an i32 value: the mask is wider than the bits that are left,
; so the field is x[28, 32).
define i32 @width_overflow(i32 %x) {
; CHECK-LABEL: width_overflow:
; CHECK:       // %bb.0:
; CHECK-NEXT:    lsr w0, w0, #28
; CHECK-NEXT:    ret
