; After the vector is scalarized, each lane is (sra (trunc (srl x, 32)), 3)
; with the shift amount 32 shared with the other srl nodes. This folds to
; (trunc (sra x, 35)) after operation legalization.

define <4 x i32> @sra_trunc_srl_shared_amount(<4 x i64> %x, <4 x i64> %y) {
