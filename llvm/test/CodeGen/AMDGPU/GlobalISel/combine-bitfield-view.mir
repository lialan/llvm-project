# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu11.00-amd-amdhsa -run-pass=amdgpu-prelegalizer-combiner -amdgpuprelegalizercombiner-only-enable-rule=bitfield_view %s -o - | FileCheck %s
# REQUIRES: asserts

# ((x >> 4) & 255) >> 2 & 15 is zext(x[6, 10)).
---
name: nested_unsigned
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: nested_unsigned
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 6
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 4
    ; CHECK-NEXT: %d:_(i32) = G_UBFX %x, [[C]](i32), [[C1]]
    ; CHECK-NEXT: $vgpr0 = COPY %d(i32)
    %x:_(i32) = COPY $vgpr0
    %c4:_(i32) = G_CONSTANT i32 4
    %c255:_(i32) = G_CONSTANT i32 255
    %c2:_(i32) = G_CONSTANT i32 2
    %c15:_(i32) = G_CONSTANT i32 15
    %a:_(i32) = G_LSHR %x, %c4
    %b:_(i32) = G_AND %a, %c255
    %c:_(i32) = G_LSHR %b, %c2
    %d:_(i32) = G_AND %c, %c15
    $vgpr0 = COPY %d
...

# ((x >>a 4) << 16) >>a 20 is sext(x[8, 20)).
---
name: nested_signed
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: nested_signed
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 8
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 12
    ; CHECK-NEXT: %c:_(i32) = G_SBFX %x, [[C]](i32), [[C1]]
    ; CHECK-NEXT: $vgpr0 = COPY %c(i32)
    %x:_(i32) = COPY $vgpr0
    %c4:_(i32) = G_CONSTANT i32 4
    %c16:_(i32) = G_CONSTANT i32 16
    %c20:_(i32) = G_CONSTANT i32 20
    %a:_(i32) = G_ASHR %x, %c4
    %b:_(i32) = G_SHL %a, %c16
    %c:_(i32) = G_ASHR %b, %c20
    $vgpr0 = COPY %c
...

# Poison-generating flags are not kept on the replacement.
---
name: nested_flags
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: nested_flags
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 6
    ; CHECK-NEXT: %c:_(i32) = G_UBFX %x, [[C]](i32), [[C]]
    ; CHECK-NEXT: $vgpr0 = COPY %c(i32)
    %x:_(i32) = COPY $vgpr0
    %c4:_(i32) = G_CONSTANT i32 4
    %c255:_(i32) = G_CONSTANT i32 255
    %c2:_(i32) = G_CONSTANT i32 2
    %a:_(i32) = exact G_LSHR %x, %c4
    %b:_(i32) = G_AND %a, %c255
    %c:_(i32) = exact G_LSHR %b, %c2
    $vgpr0 = COPY %c
...

# trunc((x >> 20) & 0xffff) >> 4 & 0xff of an i64 x is zext(x[24, 32)), which
# reaches the top of the low half.
---
name: field_of_i64
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    ; CHECK-LABEL: name: field_of_i64
    ; CHECK: liveins: $vgpr0_vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i64) = COPY $vgpr0_vgpr1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 24
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(i32) = G_TRUNC %x(i64)
    ; CHECK-NEXT: %e:_(i32) = G_LSHR [[TRUNC]], [[C]](i32)
    ; CHECK-NEXT: $vgpr0 = COPY %e(i32)
    %x:_(i64) = COPY $vgpr0_vgpr1
    %c20:_(i32) = G_CONSTANT i32 20
    %cffff:_(i64) = G_CONSTANT i64 65535
    %c4:_(i32) = G_CONSTANT i32 4
    %cff:_(i32) = G_CONSTANT i32 255
    %a:_(i64) = G_LSHR %x, %c20
    %b:_(i64) = G_AND %a, %cffff
    %c:_(i32) = G_TRUNC %b
    %d:_(i32) = G_LSHR %c, %c4
    %e:_(i32) = G_AND %d, %cff
    $vgpr0 = COPY %e
...

# A field of an i64 value that stays in the i64 type.
---
name: nested_i64
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    ; CHECK-LABEL: name: nested_i64
    ; CHECK: liveins: $vgpr0_vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i64) = COPY $vgpr0_vgpr1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 12
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 8
    ; CHECK-NEXT: %d:_(i64) = G_UBFX %x, [[C]](i32), [[C1]]
    ; CHECK-NEXT: $vgpr0_vgpr1 = COPY %d(i64)
    %x:_(i64) = COPY $vgpr0_vgpr1
    %c8:_(i32) = G_CONSTANT i32 8
    %cffffff:_(i64) = G_CONSTANT i64 16777215
    %c4:_(i32) = G_CONSTANT i32 4
    %cff:_(i64) = G_CONSTANT i64 255
    %a:_(i64) = G_LSHR %x, %c8
    %b:_(i64) = G_AND %a, %cffffff
    %c:_(i64) = G_LSHR %b, %c4
    %d:_(i64) = G_AND %c, %cff
    $vgpr0_vgpr1 = COPY %d
...

# Bits [36, 44) of the concatenation of lo and hi are hi[4, 12).
---
name: field_of_merge
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: field_of_merge
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %hi:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 4
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 8
    ; CHECK-NEXT: %c:_(i32) = G_UBFX %hi, [[C]](i32), [[C1]]
    ; CHECK-NEXT: $vgpr0 = COPY %c(i32)
    %lo:_(i32) = COPY $vgpr0
    %hi:_(i32) = COPY $vgpr1
    %c36:_(i32) = G_CONSTANT i32 36
    %cff:_(i32) = G_CONSTANT i32 255
    %m:_(i64) = G_MERGE_VALUES %lo, %hi
    %a:_(i64) = G_LSHR %m, %c36
    %b:_(i32) = G_TRUNC %a
    %c:_(i32) = G_AND %b, %cff
    $vgpr0 = COPY %c
...

# (zext(lo) | zext(hi) << 16) >> 20 & 0xff is zext(hi[4, 12)): zext(lo) is zero
# in the field.
---
name: field_of_or_concat
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: field_of_or_concat
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %hi32:_(i32) = COPY $vgpr1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 4
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 8
    ; CHECK-NEXT: %b:_(i32) = G_UBFX %hi32, [[C]](i32), [[C1]]
    ; CHECK-NEXT: $vgpr0 = COPY %b(i32)
    %lo32:_(i32) = COPY $vgpr0
    %hi32:_(i32) = COPY $vgpr1
    %lo:_(i16) = G_TRUNC %lo32
    %hi:_(i16) = G_TRUNC %hi32
    %c16:_(i32) = G_CONSTANT i32 16
    %c20:_(i32) = G_CONSTANT i32 20
    %cff:_(i32) = G_CONSTANT i32 255
    %zlo:_(i32) = G_ZEXT %lo
    %zhi:_(i32) = G_ZEXT %hi
    %shi:_(i32) = G_SHL %zhi, %c16
    %v:_(i32) = G_OR %zlo, %shi
    %a:_(i32) = G_LSHR %v, %c20
    %b:_(i32) = G_AND %a, %cff
    $vgpr0 = COPY %b
...

# The mask 0xf0f selects two fields, so ((x >> 4) & 0xf0f) >> 2 & 0x3ff is not
# a field of x.
---
name: two_field_mask
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: two_field_mask
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %c4:_(i32) = G_CONSTANT i32 4
    ; CHECK-NEXT: %cf0f:_(i32) = G_CONSTANT i32 3855
    ; CHECK-NEXT: %c2:_(i32) = G_CONSTANT i32 2
    ; CHECK-NEXT: %a:_(i32) = G_LSHR %x, %c4(i32)
    ; CHECK-NEXT: %b:_(i32) = G_AND %a, %cf0f
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 10
    ; CHECK-NEXT: %d:_(i32) = G_UBFX %b, %c2(i32), [[C]]
    ; CHECK-NEXT: $vgpr0 = COPY %d(i32)
    %x:_(i32) = COPY $vgpr0
    %c4:_(i32) = G_CONSTANT i32 4
    %cf0f:_(i32) = G_CONSTANT i32 3855
    %c2:_(i32) = G_CONSTANT i32 2
    %c3ff:_(i32) = G_CONSTANT i32 1023
    %a:_(i32) = G_LSHR %x, %c4
    %b:_(i32) = G_AND %a, %cf0f
    %c:_(i32) = G_LSHR %b, %c2
    %d:_(i32) = G_AND %c, %c3ff
    $vgpr0 = COPY %d
...

# A shift by 40 of an i32 value is poison: the view does not look through it.
---
name: out_of_range_shift
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: out_of_range_shift
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %c4:_(i32) = G_CONSTANT i32 4
    ; CHECK-NEXT: %c40:_(i32) = G_CONSTANT i32 40
    ; CHECK-NEXT: %c15:_(i32) = G_CONSTANT i32 15
    ; CHECK-NEXT: %a:_(i32) = G_LSHR %x, %c4(i32)
    ; CHECK-NEXT: %b:_(i32) = G_LSHR %a, %c40(i32)
    ; CHECK-NEXT: %c:_(i32) = G_AND %b, %c15
    ; CHECK-NEXT: $vgpr0 = COPY %c(i32)
    %x:_(i32) = COPY $vgpr0
    %c4:_(i32) = G_CONSTANT i32 4
    %c40:_(i32) = G_CONSTANT i32 40
    %c15:_(i32) = G_CONSTANT i32 15
    %a:_(i32) = G_LSHR %x, %c4
    %b:_(i32) = G_LSHR %a, %c40
    %c:_(i32) = G_AND %b, %c15
    $vgpr0 = COPY %c
...

# A G_UBFX of 16 bits at bit 20 of an i32 value is poison: the view does not
# look through it.
---
name: width_overflow
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: width_overflow
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %c20:_(i32) = G_CONSTANT i32 20
    ; CHECK-NEXT: %c16:_(i32) = G_CONSTANT i32 16
    ; CHECK-NEXT: %c4:_(i32) = G_CONSTANT i32 4
    ; CHECK-NEXT: %u:_(i32) = G_UBFX %x, %c20(i32), %c16
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 8
    ; CHECK-NEXT: %b:_(i32) = G_UBFX %u, %c4(i32), [[C]]
    ; CHECK-NEXT: $vgpr0 = COPY %b(i32)
    %x:_(i32) = COPY $vgpr0
    %c20:_(i32) = G_CONSTANT i32 20
    %c16:_(i32) = G_CONSTANT i32 16
    %c4:_(i32) = G_CONSTANT i32 4
    %cff:_(i32) = G_CONSTANT i32 255
    %u:_(i32) = G_UBFX %x, %c20, %c16
    %a:_(i32) = G_LSHR %u, %c4
    %b:_(i32) = G_AND %a, %cff
    $vgpr0 = COPY %b
...

# The zero extension of a sign-extended field is not a field.
---
name: zext_of_sext
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: zext_of_sext
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %cffff:_(i32) = G_CONSTANT i32 65535
    ; CHECK-NEXT: %b:_(i32) = G_SEXT_INREG %x, 8
    ; CHECK-NEXT: %c:_(i32) = G_AND %b, %cffff
    ; CHECK-NEXT: $vgpr0 = COPY %c(i32)
    %x:_(i32) = COPY $vgpr0
    %c24:_(i32) = G_CONSTANT i32 24
    %cffff:_(i32) = G_CONSTANT i32 65535
    %a:_(i32) = G_SHL %x, %c24
    %b:_(i32) = G_ASHR %a, %c24
    %c:_(i32) = G_AND %b, %cffff
    $vgpr0 = COPY %c
...

# The sign extension of a zero-extended field is a zero extension:
# sext_inreg(x >> 20, 16) is zext(x[20, 32)).
---
name: sext_of_zext
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: sext_of_zext
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %c20:_(i32) = G_CONSTANT i32 20
    ; CHECK-NEXT: %a:_(i32) = G_LSHR %x, %c20(i32)
    ; CHECK-NEXT: %b:_(i32) = COPY %a(i32)
    ; CHECK-NEXT: $vgpr0 = COPY %b(i32)
    %x:_(i32) = COPY $vgpr0
    %c20:_(i32) = G_CONSTANT i32 20
    %a:_(i32) = G_LSHR %x, %c20
    %b:_(i32) = G_SEXT_INREG %a, 16
    $vgpr0 = COPY %b
...

# A field is not looked for through G_FREEZE.
---
name: freeze
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: freeze
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %c4:_(i32) = G_CONSTANT i32 4
    ; CHECK-NEXT: %c2:_(i32) = G_CONSTANT i32 2
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 8
    ; CHECK-NEXT: %b:_(i32) = G_UBFX %x, %c4(i32), [[C]]
    ; CHECK-NEXT: %f:_(i32) = G_FREEZE %b
    ; CHECK-NEXT: %d:_(i32) = G_UBFX %f, %c2(i32), %c4
    ; CHECK-NEXT: $vgpr0 = COPY %d(i32)
    %x:_(i32) = COPY $vgpr0
    %c4:_(i32) = G_CONSTANT i32 4
    %c255:_(i32) = G_CONSTANT i32 255
    %c2:_(i32) = G_CONSTANT i32 2
    %c15:_(i32) = G_CONSTANT i32 15
    %a:_(i32) = G_LSHR %x, %c4
    %b:_(i32) = G_AND %a, %c255
    %f:_(i32) = G_FREEZE %b
    %c:_(i32) = G_LSHR %f, %c2
    %d:_(i32) = G_AND %c, %c15
    $vgpr0 = COPY %d
...

# %c has another use: it becomes one G_UBFX of x, but %d stays a G_AND of %c,
# since a G_UBFX of x would only replace the G_AND.
---
name: multi_use
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: multi_use
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %c15:_(i32) = G_CONSTANT i32 15
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 6
    ; CHECK-NEXT: %c:_(i32) = G_UBFX %x, [[C]](i32), [[C]]
    ; CHECK-NEXT: %d:_(i32) = G_AND %c, %c15
    ; CHECK-NEXT: $vgpr0 = COPY %d(i32)
    ; CHECK-NEXT: $vgpr1 = COPY %c(i32)
    %x:_(i32) = COPY $vgpr0
    %c4:_(i32) = G_CONSTANT i32 4
    %c8:_(i32) = G_CONSTANT i32 8
    %c2:_(i32) = G_CONSTANT i32 2
    %c15:_(i32) = G_CONSTANT i32 15
    %b:_(i32) = G_UBFX %x, %c4, %c8
    %c:_(i32) = G_LSHR %b, %c2
    %d:_(i32) = G_AND %c, %c15
    $vgpr0 = COPY %d
    $vgpr1 = COPY %c
...
