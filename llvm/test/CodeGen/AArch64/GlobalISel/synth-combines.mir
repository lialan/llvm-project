    ; ON-NEXT: $w0 = COPY %r(s32)
    ; ON-NEXT: RET_ReallyLR implicit $w0
    %a:_(s32) = COPY $w0
    %z:_(s32) = G_CONSTANT i32 0
    %n:_(s32) = G_SUB %z, %a
    %r:_(s32) = G_SMAX %n, %a
    $w0 = COPY %r(s32)
    RET_ReallyLR implicit $w0
...
