; CHECK-NEXT:    sll $2, $2, 0
; CHECK-NEXT:    dsra $3, $6, 35
; CHECK-NEXT:    sll $3, $3, 0
; CHECK-NEXT:    addu $3, $3, $2
; CHECK-NEXT:    dsrl $2, $9, 32
; CHECK-NEXT:    dsll $1, $1, 32
; CHECK-NEXT:    sll $2, $2, 0
; CHECK-NEXT:    dsra $4, $5, 35
; CHECK-NEXT:    sll $4, $4, 0
; CHECK-NEXT:    addu $2, $4, $2
; CHECK-NEXT:    dsll $2, $2, 32
; CHECK-NEXT:    dsrl $2, $2, 32
; CHECK-NEXT:    dsrl $4, $11, 32
