---
name: lshr_ubfx
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: lshr_ubfx
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $w0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 10
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 6
    ; CHECK-NEXT: %r:_(i32) = G_UBFX %x, [[C]](i32), [[C1]]
    ; CHECK-NEXT: $w0 = COPY %r(i32)
    %x:_(i32) = COPY $w0
    %c2:_(i32) = G_CONSTANT i32 2
    %c8:_(i32) = G_CONSTANT i32 8
    %f:_(i32) = G_UBFX %x, %c8(i32), %c8
    %r:_(i32) = G_LSHR %f, %c2
    $w0 = COPY %r
...

---
name: and_trunc_lshr_crossing
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0
    ; CHECK-LABEL: name: and_trunc_lshr_crossing
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i64) = COPY $x0
    ; CHECK-NEXT: %c28:_(i64) = G_CONSTANT i64 28
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 8
    ; CHECK-NEXT: [[UBFX:%[0-9]+]]:_(i64) = G_UBFX %x, %c28(i64), [[C]]
    ; CHECK-NEXT: %r:_(i32) = G_TRUNC [[UBFX]](i64)
    ; CHECK-NEXT: $w0 = COPY %r(i32)
    %x:_(i64) = COPY $x0
    %c28:_(i64) = G_CONSTANT i64 28
    %mask:_(i32) = G_CONSTANT i32 255
    %s:_(i64) = G_LSHR %x, %c28
    %t:_(i32) = G_TRUNC %s
    %r:_(i32) = G_AND %t, %mask
    $w0 = COPY %r
...

