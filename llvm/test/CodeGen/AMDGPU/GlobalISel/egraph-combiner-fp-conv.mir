---
# Two extensions are one extension.
name: fpext_of_fpext
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: fpext_of_fpext
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(i16) = G_TRUNC [[COPY]](i32)
    ; CHECK-NEXT: %a:_(f16) = G_BITCAST [[TRUNC]](i16)
    ; CHECK-NEXT: [[FPEXT:%[0-9]+]]:_(f64) = G_FPEXT %a(f16)
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(i32), [[UV1:%[0-9]+]]:_(i32) = G_UNMERGE_VALUES [[FPEXT]](f64)
    ; CHECK-NEXT: $vgpr0 = COPY [[UV]](i32)
    ; CHECK-NEXT: $vgpr1 = COPY [[UV1]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %0:_(i32) = COPY $vgpr0
    %1:_(i16) = G_TRUNC %0
    %a:_(f16) = G_BITCAST %1
    %b:_(f32) = G_FPEXT %a
    %c:_(f64) = G_FPEXT %b
    %lo:_(i32), %hi:_(i32) = G_UNMERGE_VALUES %c
    $vgpr0 = COPY %lo
    $vgpr1 = COPY %hi
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...
---
# An extension is exact, so the truncation to the first format gives the
# value again.
name: fptrunc_of_fpext
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: fptrunc_of_fpext
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(f32) = COPY $vgpr0
    ; CHECK-NEXT: $vgpr0 = COPY %a(f32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(f32) = COPY $vgpr0
    %b:_(f64) = G_FPEXT %a
    %c:_(f32) = G_FPTRUNC %b
    $vgpr0 = COPY %c
    SI_RETURN implicit $vgpr0
...
---
