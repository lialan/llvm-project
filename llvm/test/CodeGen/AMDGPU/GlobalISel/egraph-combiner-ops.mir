  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $vgpr0 = COPY %b(s32)
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
