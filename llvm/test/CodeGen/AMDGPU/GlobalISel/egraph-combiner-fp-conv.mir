    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[SEXT_INREG:%[0-9]+]]:_(i32) = G_SEXT_INREG [[COPY]], 16
    ; CHECK-NEXT: $vgpr0 = COPY [[SEXT_INREG]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %0:_(i32) = COPY $vgpr0
    %a:_(i16) = G_TRUNC %0
    %f:_(f32) = G_SITOFP %a
    %r:_(i32) = G_FPTOSI %f
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
