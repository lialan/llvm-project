    ; CHECK-NEXT: %f:_(f32) = G_SITOFP %a(i32)
    ; CHECK-NEXT: %r:_(i16) = G_FPTOSI_SAT %f(f32)
    ; CHECK-NEXT: %e:_(i32) = G_ANYEXT %r(i16)
    ; CHECK-NEXT: $vgpr0 = COPY %e(i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(i32) = COPY $vgpr0
    %f:_(f32) = G_SITOFP %a
    %r:_(i16) = G_FPTOSI_SAT %f
    %e:_(i32) = G_ANYEXT %r
    $vgpr0 = COPY %e
    SI_RETURN implicit $vgpr0
...
