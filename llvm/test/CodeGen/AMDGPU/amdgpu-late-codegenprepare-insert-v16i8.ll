; The packed result crossing blocks is still coerced by the live reg optimizer.
define amdgpu_kernel void @loop(ptr addrspace(1) %out, <16 x i8> %init, i8 %val, i32 %n) {
; CHECK-LABEL: define amdgpu_kernel void @loop(
; CHECK-SAME: ptr addrspace(1) [[OUT:%.*]], <16 x i8> [[INIT:%.*]], i8 [[VAL:%.*]], i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[VEC:%.*]] = phi <16 x i8> [ [[INIT]], %[[ENTRY]] ], [ [[INS:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[I1:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = freeze <16 x i8> [[VEC]]
; CHECK-NEXT:    [[TMP1:%.*]] = bitcast <16 x i8> [[TMP0]] to <4 x i32>
; CHECK-NEXT:    [[TMP2:%.*]] = freeze i8 [[VAL]]
; CHECK-NEXT:    [[TMP3:%.*]] = zext i8 [[TMP2]] to i32
; CHECK-NEXT:    [[I:%.*]] = freeze i32 [[I1]]
; CHECK-NEXT:    [[TMP4:%.*]] = and i32 [[I]], 3
; CHECK-NEXT:    [[TMP5:%.*]] = shl i32 [[TMP4]], 3
; CHECK-NEXT:    [[TMP6:%.*]] = shl i32 255, [[TMP5]]
; CHECK-NEXT:    [[TMP7:%.*]] = shl i32 [[TMP3]], [[TMP5]]
; CHECK-NEXT:    [[TMP8:%.*]] = lshr i32 [[I]], 2
; CHECK-NEXT:    [[TMP9:%.*]] = extractelement <4 x i32> [[TMP1]], i32 [[TMP8]]
; CHECK-NEXT:    [[TMP11:%.*]] = xor i32 [[TMP6]], -1
; CHECK-NEXT:    [[TMP12:%.*]] = and i32 [[TMP9]], [[TMP11]]
; CHECK-NEXT:    [[TMP13:%.*]] = or disjoint i32 [[TMP7]], [[TMP12]]
; CHECK-NEXT:    [[TMP14:%.*]] = insertelement <4 x i32> [[TMP1]], i32 [[TMP13]], i32 [[TMP8]]
; CHECK-NEXT:    [[INS]] = bitcast <4 x i32> [[TMP14]] to <16 x i8>
; CHECK-NEXT:    [[I_NEXT]] = add i32 [[I1]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    store <16 x i8> [[INS]], ptr addrspace(1) [[OUT]], align 16
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %vec = phi <16 x i8> [ %init, %entry ], [ %ins, %loop ]
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %ins = insertelement <16 x i8> %vec, i8 %val, i32 %i
  %i.next = add i32 %i, 1
  %cmp = icmp ult i32 %i.next, %n
  br i1 %cmp, label %loop, label %exit

exit:
  store <16 x i8> %ins, ptr addrspace(1) %out
  ret void
}

