    ; CHECK-NEXT: [[SELECT:%[0-9]+]]:_(s32) = G_SELECT %c(s1), [[C]], [[C1]]
    ; CHECK-NEXT: $vgpr0 = COPY [[SELECT]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %x:_(s32) = COPY $vgpr0
    %c:_(s1) = G_TRUNC %x
    %one:_(s32) = G_CONSTANT i32 1
    %two:_(s32) = G_CONSTANT i32 2
    %ten:_(s32) = G_CONSTANT i32 10
    %s:_(s32) = G_SELECT %c, %one, %two
    %r:_(s32) = G_ADD %s, %ten
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# (select c, 1, 2) == 1 ==> c
name: icmp_of_select
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: icmp_of_select
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %one:_(s32) = G_CONSTANT i32 1
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(s32) = G_AND %x, %one
    ; CHECK-NEXT: $vgpr0 = COPY [[AND]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %x:_(s32) = COPY $vgpr0
