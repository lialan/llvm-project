...

# On s1, a + a is 0, not a << 1 (which would shift out of range):
# ((a + a) + (b + 1)) + 1 -> (a + a) + b
---
name: add_repeated_leaf_s1
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: add_repeated_leaf_s1
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a32:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b32:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: %a:_(s1) = G_TRUNC %a32(s32)
    ; CHECK-NEXT: %b:_(s1) = G_TRUNC %b32(s32)
    ; CHECK-NEXT: %x:_(s1) = G_ADD %a, %a
    ; CHECK-NEXT: %r:_(s1) = G_ADD %x, %b
    ; CHECK-NEXT: %ext:_(s32) = G_ZEXT %r(s1)
    ; CHECK-NEXT: $vgpr0 = COPY %ext(s32)
    %a32:_(s32) = COPY $vgpr0
    %b32:_(s32) = COPY $vgpr1
    %a:_(s1) = G_TRUNC %a32
    %b:_(s1) = G_TRUNC %b32
    %one:_(s1) = G_CONSTANT i1 true
    %x:_(s1) = G_ADD %a, %a
    %y:_(s1) = G_ADD %b, %one
    %s:_(s1) = G_ADD %x, %y
    %r:_(s1) = G_ADD %s, %one
    %ext:_(s32) = G_ZEXT %r
    $vgpr0 = COPY %ext
...

# Splat constants: (a + <1, 1>) + (b + <2, 2>) -> (a + b) + <3, 3>
---
