# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -amdgpu-stress-vgpr=2 -run-pass=greedy,virt-reg-rewriter -verify-regalloc -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=GCN,UNIFIED
# RUN: llc -mtriple=amdgpu9.42-amd-amdhsa -amdgpu-stress-vgpr=2 -run-pass=greedy,virt-reg-rewriter -verify-regalloc -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=GCN,UNIFIED
# RUN: llc -mtriple=amdgpu9.08-amd-amdhsa -amdgpu-stress-vgpr=2 -run-pass=greedy,virt-reg-rewriter -verify-regalloc -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=GCN,SEPARATE
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -amdgpu-regalloc-agpr-cost=0 -amdgpu-stress-vgpr=2 -run-pass=greedy,virt-reg-rewriter -verify-regalloc -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=GCN,SEPARATE

# A free AGPR must not prevent rematerializing the single-copy fragment left
# by splitting %saved. Its input remains available, and replacing the copy
# with V_OR needs only the two VGPRs already in use.
---
name: remat_before_agpr
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  occupancy: 2
body: |
  bb.0:
    ; GCN-LABEL: name: remat_before_agpr
    ; UNIFIED: bb.0:
    ; UNIFIED-NEXT: S_NOP 0, implicit-def renamable $vgpr0
    ; UNIFIED-NEXT: S_NOP 0, implicit-def renamable $vgpr1
    ; UNIFIED-NEXT: S_NOP 0, implicit renamable $vgpr0, implicit killed renamable $vgpr1
    ; UNIFIED-NEXT: renamable $vgpr1 = V_OR_B32_e32 3, $vgpr0, implicit $exec
    ; UNIFIED-NEXT: renamable $vgpr1 = V_ADD_U32_e32 1, killed $vgpr1, implicit $exec
    ; UNIFIED-NEXT: S_NOP 0, implicit killed renamable $vgpr0, implicit killed renamable $vgpr1
    ; UNIFIED-NEXT: S_ENDPGM 0
    ; SEPARATE: renamable $vgpr1 = V_OR_B32_e32
    ; SEPARATE-NEXT: renamable $agpr0 = lr-split COPY killed renamable $vgpr1
    ; SEPARATE: renamable $vgpr1 = lr-split COPY killed renamable $agpr0
    ; SEPARATE-NEXT: renamable $vgpr1 = V_ADD_U32_e32
    S_NOP 0, implicit-def %base:vgpr_32
    %saved:vgpr_32 = V_OR_B32_e32 3, %base, implicit $exec
    S_NOP 0, implicit-def %tmp:vgpr_32
    S_NOP 0, implicit %base, implicit %tmp
    %result:vgpr_32 = V_ADD_U32_e32 1, %saved, implicit $exec
    S_NOP 0, implicit %base, implicit %result
    S_ENDPGM 0
...

# There is no occupancy left to protect at occupancy one.
---
name: retain_at_occupancy_one
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  occupancy: 1
body: |
  bb.0:
    ; GCN-LABEL: name: retain_at_occupancy_one
    ; GCN: renamable $vgpr1 = V_OR_B32_e32
    ; GCN-NEXT: renamable $agpr0 = lr-split COPY killed renamable $vgpr1
    ; GCN: renamable $vgpr1 = lr-split COPY killed renamable $agpr0
    ; GCN-NEXT: renamable $vgpr1 = V_ADD_U32_e32
    S_NOP 0, implicit-def %base:vgpr_32
    %saved:vgpr_32 = V_OR_B32_e32 3, %base, implicit $exec
    S_NOP 0, implicit-def %tmp:vgpr_32
    S_NOP 0, implicit %base, implicit %tmp
    %result:vgpr_32 = V_ADD_U32_e32 1, %saved, implicit $exec
    S_NOP 0, implicit %base, implicit %result
    S_ENDPGM 0
...

# Prefer evicting the less expensive global interval from a VGPR to putting
# %tmp in a free AGPR. Rematerialization then eliminates the AGPR spill
# fragment that would otherwise hold %saved across bb.1.
---
name: evict_before_agpr
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  occupancy: 2
body: |
  bb.0:
    ; GCN-LABEL: name: evict_before_agpr
    ; UNIFIED: bb.0:
    ; UNIFIED: S_NOP 0, implicit-def renamable $vgpr0
    ; UNIFIED-NEXT: S_BRANCH %bb.1
    ; UNIFIED: bb.1:
    ; UNIFIED: S_NOP 0, implicit-def renamable $vgpr1
    ; UNIFIED-NEXT: S_NOP 0, implicit renamable $vgpr1
    ; UNIFIED-NEXT: S_NOP 0, implicit renamable $vgpr1
    ; UNIFIED-NEXT: S_NOP 0, implicit renamable $vgpr1
    ; UNIFIED-NEXT: S_NOP 0, implicit killed renamable $vgpr1
    ; UNIFIED-NEXT: S_BRANCH %bb.2
    ; UNIFIED: bb.2:
    ; UNIFIED: renamable $vgpr1 = V_OR_B32_e32 3, $vgpr0, implicit $exec
    ; UNIFIED-NEXT: renamable $vgpr1 = V_ADD_U32_e32 1, killed $vgpr1, implicit $exec
    ; UNIFIED-NEXT: S_NOP 0, implicit killed renamable $vgpr0, implicit killed renamable $vgpr1
    ; UNIFIED-NEXT: S_ENDPGM 0
    ; SEPARATE: renamable $vgpr1 = V_OR_B32_e32
    ; SEPARATE: bb.1:
    ; SEPARATE: S_NOP 0, implicit-def renamable $agpr0
    ; SEPARATE: bb.2:
    ; SEPARATE: renamable $vgpr1 = V_ADD_U32_e32
    S_NOP 0, implicit-def %base:vgpr_32
    %saved:vgpr_32 = V_OR_B32_e32 3, %base, implicit $exec
    S_BRANCH %bb.1
  bb.1:
    S_NOP 0, implicit-def %tmp:av_32
    S_NOP 0, implicit %tmp
    S_NOP 0, implicit %tmp
    S_NOP 0, implicit %tmp
    S_NOP 0, implicit %tmp
    S_BRANCH %bb.2
  bb.2:
    %result:vgpr_32 = V_ADD_U32_e32 1, %saved, implicit $exec
    S_NOP 0, implicit %base, implicit %result
    S_ENDPGM 0
...

# Keep the AGPR allocation when recomputing the value is not possible.
---
name: retain_nonremat
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  occupancy: 2
body: |
  bb.0:
    ; GCN-LABEL: name: retain_nonremat
    ; GCN: bb.0:
    ; GCN-NEXT: S_NOP 0, implicit-def renamable $vgpr0
    ; GCN-NEXT: S_NOP 0, implicit-def renamable $agpr0
    ; GCN-NEXT: S_NOP 0, implicit-def renamable $vgpr1
    ; GCN-NEXT: S_NOP 0, implicit renamable $vgpr0, implicit killed renamable $vgpr1
    ; GCN-NEXT: renamable $vgpr1 = lr-split COPY killed renamable $agpr0
    ; GCN-NEXT: renamable $vgpr1 = V_ADD_U32_e32 1, killed $vgpr1, implicit $exec
    ; GCN-NEXT: S_NOP 0, implicit killed renamable $vgpr0, implicit killed renamable $vgpr1
    ; GCN-NEXT: S_ENDPGM 0
    S_NOP 0, implicit-def %base:vgpr_32
    S_NOP 0, implicit-def %saved:vgpr_32
    S_NOP 0, implicit-def %tmp:vgpr_32
    S_NOP 0, implicit %base, implicit %tmp
    %result:vgpr_32 = V_ADD_U32_e32 1, %saved, implicit $exec
    S_NOP 0, implicit %base, implicit %result
    S_ENDPGM 0
...

# Avoid evicting a value that would need to be stored in another register bank.
# Keep %tmp in the free AGPR when neither occupied VGPR can be rematerialized.
---
name: retain_nonremat_eviction
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
  occupancy: 2
body: |
  bb.0:
    ; GCN-LABEL: name: retain_nonremat_eviction
    ; GCN: bb.1:
    ; GCN: S_NOP 0, implicit-def renamable $agpr0
    ; GCN-NEXT: S_NOP 0, implicit renamable $agpr0
    ; GCN-NEXT: S_NOP 0, implicit renamable $agpr0
    ; GCN-NEXT: S_NOP 0, implicit renamable $agpr0
    ; GCN-NEXT: S_NOP 0, implicit killed renamable $agpr0
    ; GCN: bb.2:
    ; GCN: renamable $vgpr1 = V_ADD_U32_e32
    S_NOP 0, implicit-def %base:vgpr_32
    S_NOP 0, implicit-def %saved:vgpr_32
    S_BRANCH %bb.1
  bb.1:
    S_NOP 0, implicit-def %tmp:av_32
    S_NOP 0, implicit %tmp
    S_NOP 0, implicit %tmp
    S_NOP 0, implicit %tmp
    S_NOP 0, implicit %tmp
    S_BRANCH %bb.2
  bb.2:
    %result:vgpr_32 = V_ADD_U32_e32 1, %saved, implicit $exec
    S_NOP 0, implicit %base, implicit %result
    S_ENDPGM 0
...
