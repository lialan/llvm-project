# The 16-bit shift of a truncation is done in 32 bits when the bits that the
# narrow shift fills are not demanded.
---
name: sext_inreg_anyext_lshr_trunc
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: sext_inreg_anyext_lshr_trunc
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 4
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(i32) = G_LSHR %x, [[C]](i32)
    ; CHECK-NEXT: %r:_(i32) = G_SEXT_INREG [[LSHR]], 8
    ; CHECK-NEXT: $vgpr0 = COPY %r(i32)
    %x:_(i32) = COPY $vgpr0
    %c4:_(i16) = G_CONSTANT i16 4
    %t:_(i16) = G_TRUNC %x
    %s:_(i16) = G_LSHR %t, %c4
    %e:_(i32) = G_ANYEXT %s
    %r:_(i32) = G_SEXT_INREG %e, 8
    $vgpr0 = COPY %r
...

