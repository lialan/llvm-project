# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn-amd-amdhsa -run-pass=gisel-egraph-combiner -gisel-egraph-mode=rewrite %s -o - | FileCheck %s --check-prefix=POST
# RUN: llc -mtriple=amdgcn-amd-amdhsa -run-pass=gisel-egraph-combiner -gisel-egraph-mode=rewrite -gisel-egraph-stages=pre-legalizer %s -o - | FileCheck %s --check-prefix=PRE

# The position of the pass after the legalizer: the functions are legalized.
# The pass creates only legal instructions and constants, and it does not
# emit again the instructions that the result uses unchanged. With
# -gisel-egraph-stages=pre-legalizer, the pass does not run on a legalized
# function.

# G_SMIN is legal for 32 bits.
---
name: smin_s32
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; POST-LABEL: name: smin_s32
    ; POST: liveins: $vgpr0, $vgpr1
    ; POST-NEXT: {{  $}}
    ; POST-NEXT: %a:_(s32) = COPY $vgpr0
    ; POST-NEXT: %b:_(s32) = COPY $vgpr1
    ; POST-NEXT: [[SMIN:%[0-9]+]]:_(s32) = G_SMIN %a, %b
    ; POST-NEXT: $vgpr0 = COPY [[SMIN]](s32)
    ; POST-NEXT: SI_RETURN implicit $vgpr0
    ;
    ; PRE-LABEL: name: smin_s32
    ; PRE: liveins: $vgpr0, $vgpr1
    ; PRE-NEXT: {{  $}}
    ; PRE-NEXT: %a:_(s32) = COPY $vgpr0
    ; PRE-NEXT: %b:_(s32) = COPY $vgpr1
    ; PRE-NEXT: %c:_(s1) = G_ICMP intpred(slt), %a(s32), %b
    ; PRE-NEXT: %s:_(s32) = G_SELECT %c(s1), %a, %b
    ; PRE-NEXT: $vgpr0 = COPY %s(s32)
    ; PRE-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c:_(s1) = G_ICMP intpred(slt), %a(s32), %b
    %s:_(s32) = G_SELECT %c(s1), %a, %b
    $vgpr0 = COPY %s(s32)
    SI_RETURN implicit $vgpr0
...

# G_SMIN is not legal for 64 bits: the select stays.
---
name: smin_s64
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3
    ; POST-LABEL: name: smin_s64
    ; POST: liveins: $vgpr0_vgpr1, $vgpr2_vgpr3
    ; POST-NEXT: {{  $}}
    ; POST-NEXT: %a:_(s64) = COPY $vgpr0_vgpr1
    ; POST-NEXT: %b:_(s64) = COPY $vgpr2_vgpr3
    ; POST-NEXT: %c:_(s1) = G_ICMP intpred(slt), %a(s64), %b
    ; POST-NEXT: %s:_(s64) = G_SELECT %c(s1), %a, %b
    ; POST-NEXT: $vgpr0_vgpr1 = COPY %s(s64)
    ; POST-NEXT: SI_RETURN implicit $vgpr0_vgpr1
    ;
    ; PRE-LABEL: name: smin_s64
    ; PRE: liveins: $vgpr0_vgpr1, $vgpr2_vgpr3
    ; PRE-NEXT: {{  $}}
    ; PRE-NEXT: %a:_(s64) = COPY $vgpr0_vgpr1
    ; PRE-NEXT: %b:_(s64) = COPY $vgpr2_vgpr3
    ; PRE-NEXT: %c:_(s1) = G_ICMP intpred(slt), %a(s64), %b
    ; PRE-NEXT: %s:_(s64) = G_SELECT %c(s1), %a, %b
    ; PRE-NEXT: $vgpr0_vgpr1 = COPY %s(s64)
    ; PRE-NEXT: SI_RETURN implicit $vgpr0_vgpr1
    %a:_(s64) = COPY $vgpr0_vgpr1
    %b:_(s64) = COPY $vgpr2_vgpr3
    %c:_(s1) = G_ICMP intpred(slt), %a(s64), %b
    %s:_(s64) = G_SELECT %c(s1), %a, %b
    $vgpr0_vgpr1 = COPY %s(s64)
    SI_RETURN implicit $vgpr0_vgpr1
...

# The legalizer can divide one value two times. One instruction stays in its
# position, and the other is removed.
---
name: two_unmerges
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    ; POST-LABEL: name: two_unmerges
    ; POST: liveins: $vgpr0_vgpr1
    ; POST-NEXT: {{  $}}
    ; POST-NEXT: %a:_(s64) = COPY $vgpr0_vgpr1
    ; POST-NEXT: %lo:_(s32), %hi:_(s32) = G_UNMERGE_VALUES %a(s64)
    ; POST-NEXT: [[ADD:%[0-9]+]]:_(s32) = G_ADD %lo, %hi
    ; POST-NEXT: $vgpr0 = COPY [[ADD]](s32)
    ; POST-NEXT: SI_RETURN implicit $vgpr0
    ;
    ; PRE-LABEL: name: two_unmerges
    ; PRE: liveins: $vgpr0_vgpr1
    ; PRE-NEXT: {{  $}}
    ; PRE-NEXT: %a:_(s64) = COPY $vgpr0_vgpr1
    ; PRE-NEXT: %lo:_(s32), %hi:_(s32) = G_UNMERGE_VALUES %a(s64)
    ; PRE-NEXT: %lo2:_(s32), %hi2:_(s32) = G_UNMERGE_VALUES %a(s64)
    ; PRE-NEXT: %s:_(s32) = G_ADD %lo, %hi2
    ; PRE-NEXT: $vgpr0 = COPY %s(s32)
    ; PRE-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s64) = COPY $vgpr0_vgpr1
    %lo:_(s32), %hi:_(s32) = G_UNMERGE_VALUES %a(s64)
    %lo2:_(s32), %hi2:_(s32) = G_UNMERGE_VALUES %a(s64)
    %s:_(s32) = G_ADD %lo, %hi2
    $vgpr0 = COPY %s(s32)
    SI_RETURN implicit $vgpr0
...

# A value can be divided in two different ways. The two instructions are
# different, and the two stay.
---
name: unmerge_two_part_types
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; POST-LABEL: name: unmerge_two_part_types
    ; POST: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; POST-NEXT: {{  $}}
    ; POST-NEXT: %a:_(s32) = COPY $vgpr0
    ; POST-NEXT: %b:_(s32) = COPY $vgpr1
    ; POST-NEXT: %c:_(s32) = COPY $vgpr2
    ; POST-NEXT: %d:_(s32) = COPY $vgpr3
    ; POST-NEXT: %m:_(s128) = G_MERGE_VALUES %a(s32), %b(s32), %c(s32), %d(s32)
    ; POST-NEXT: %f:_(s128) = G_FREEZE %m
    ; POST-NEXT: %lo:_(s64), %hi:_(s64) = G_UNMERGE_VALUES %f(s128)
    ; POST-NEXT: %p0:_(s32), %p1:_(s32), %p2:_(s32), %p3:_(s32) = G_UNMERGE_VALUES %f(s128)
    ; POST-NEXT: %h0:_(s32), %h1:_(s32) = G_UNMERGE_VALUES %hi(s64)
    ; POST-NEXT: [[XOR:%[0-9]+]]:_(s32) = G_XOR %p1, %h1
    ; POST-NEXT: $vgpr0 = COPY [[XOR]](s32)
    ; POST-NEXT: SI_RETURN implicit $vgpr0
    ;
    ; PRE-LABEL: name: unmerge_two_part_types
    ; PRE: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; PRE-NEXT: {{  $}}
    ; PRE-NEXT: %a:_(s32) = COPY $vgpr0
    ; PRE-NEXT: %b:_(s32) = COPY $vgpr1
    ; PRE-NEXT: %c:_(s32) = COPY $vgpr2
    ; PRE-NEXT: %d:_(s32) = COPY $vgpr3
    ; PRE-NEXT: %m:_(s128) = G_MERGE_VALUES %a(s32), %b(s32), %c(s32), %d(s32)
    ; PRE-NEXT: %f:_(s128) = G_FREEZE %m
    ; PRE-NEXT: %lo:_(s64), %hi:_(s64) = G_UNMERGE_VALUES %f(s128)
    ; PRE-NEXT: %p0:_(s32), %p1:_(s32), %p2:_(s32), %p3:_(s32) = G_UNMERGE_VALUES %f(s128)
    ; PRE-NEXT: %h0:_(s32), %h1:_(s32) = G_UNMERGE_VALUES %hi(s64)
    ; PRE-NEXT: %zero:_(s32) = G_CONSTANT i32 0
    ; PRE-NEXT: %x:_(s32) = G_ADD %h1, %zero
    ; PRE-NEXT: %y:_(s32) = G_XOR %p1, %x
    ; PRE-NEXT: $vgpr0 = COPY %y(s32)
    ; PRE-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c:_(s32) = COPY $vgpr2
    %d:_(s32) = COPY $vgpr3
    %m:_(s128) = G_MERGE_VALUES %a(s32), %b(s32), %c(s32), %d(s32)
    %f:_(s128) = G_FREEZE %m
    %lo:_(s64), %hi:_(s64) = G_UNMERGE_VALUES %f(s128)
    %p0:_(s32), %p1:_(s32), %p2:_(s32), %p3:_(s32) = G_UNMERGE_VALUES %f(s128)
    %h0:_(s32), %h1:_(s32) = G_UNMERGE_VALUES %hi(s64)
    %zero:_(s32) = G_CONSTANT i32 0
    %x:_(s32) = G_ADD %h1, %zero
    %y:_(s32) = G_XOR %p1, %x
    $vgpr0 = COPY %y(s32)
    SI_RETURN implicit $vgpr0
...

# The new constant has a legal type.
---
name: add_two_constants
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    ; POST-LABEL: name: add_two_constants
    ; POST: liveins: $vgpr0_vgpr1
    ; POST-NEXT: {{  $}}
    ; POST-NEXT: %a:_(s64) = COPY $vgpr0_vgpr1
    ; POST-NEXT: [[C:%[0-9]+]]:_(s64) = G_CONSTANT i64 8
    ; POST-NEXT: [[ADD:%[0-9]+]]:_(s64) = G_ADD %a, [[C]]
    ; POST-NEXT: $vgpr0_vgpr1 = COPY [[ADD]](s64)
    ; POST-NEXT: SI_RETURN implicit $vgpr0_vgpr1
    ;
    ; PRE-LABEL: name: add_two_constants
    ; PRE: liveins: $vgpr0_vgpr1
    ; PRE-NEXT: {{  $}}
    ; PRE-NEXT: %a:_(s64) = COPY $vgpr0_vgpr1
    ; PRE-NEXT: %c:_(s64) = G_CONSTANT i64 3
    ; PRE-NEXT: %d:_(s64) = G_CONSTANT i64 5
    ; PRE-NEXT: %x:_(s64) = G_ADD %a, %c
    ; PRE-NEXT: %y:_(s64) = G_ADD %x, %d
    ; PRE-NEXT: $vgpr0_vgpr1 = COPY %y(s64)
    ; PRE-NEXT: SI_RETURN implicit $vgpr0_vgpr1
    %a:_(s64) = COPY $vgpr0_vgpr1
    %c:_(s64) = G_CONSTANT i64 3
    %d:_(s64) = G_CONSTANT i64 5
    %x:_(s64) = G_ADD %a, %c
    %y:_(s64) = G_ADD %x, %d
    $vgpr0_vgpr1 = COPY %y(s64)
    SI_RETURN implicit $vgpr0_vgpr1
...
