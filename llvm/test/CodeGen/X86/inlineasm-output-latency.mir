# RUN: llc -mtriple=x86_64 -mcpu=skylake -run-pass=machine-scheduler -verify-misched -debug-only=machine-scheduler %s -filetype=null 2>&1 | FileCheck %s
# RUN: llc -mtriple=x86_64 -mcpu=skylake -enable-post-misched -run-pass=postmisched -verify-misched -debug-only=machine-scheduler %s -filetype=null 2>&1 | FileCheck %s
# REQUIRES: asserts

# Check the latency of physical-register outputs of inline asm feeding other
# instructions. Outputs in an asm operand group, including fixed-register
# outputs, are real definitions. Trailing register bookkeeping operands are
# not part of any group and keep zero latency.

---
name: asm_output_to_native_input
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: asm_output_to_native_input:%bb.0
  ; CHECK: SU(0): {{.*}}INLINEASM
  ; CHECK: SU(1): Data Latency=1 Reg=$rax
  bb.0:
    INLINEASM &"# def $0", attdialect, regdef:GR64, def $rax
    $rcx = MOV64rr $rax
    RET 0
...

# An inline asm that may load gets the load latency.
---
name: asm_mayload_output_to_native_input
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: asm_mayload_output_to_native_input:%bb.0
  ; CHECK: SU(0): {{.*}}INLINEASM
  ; CHECK: SU(1): Data Latency=5 Reg=$rax
  bb.0:
    liveins: $rdi
    INLINEASM &"mov ($1), $0", mayload attdialect, regdef:GR64, def $rax, reguse:GR64, $rdi
    $rcx = MOV64rr $rax
    RET 0
...

# Fixed-register output constraints are emitted with implicit-def on the real
# output operand, inside its regdef group.
---
name: asm_fixed_output_to_native_input
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: asm_fixed_output_to_native_input:%bb.0
  ; CHECK: SU(0): {{.*}}INLINEASM
  ; CHECK: SU(1): Data Latency=1 Reg=$rax
  bb.0:
    ; Output constraint: "={rax}".
    INLINEASM &"mov $$1, $0", sideeffect attdialect, regdef, implicit-def $rax
    $rcx = MOV64rr $rax
    RET 0
...

---
name: asm_fixed_earlyclobber_output_to_native_input
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: asm_fixed_earlyclobber_output_to_native_input:%bb.0
  ; CHECK: SU(0): {{.*}}INLINEASM
  ; CHECK: SU(1): Data Latency=1 Reg=$rax
  bb.0:
    ; Output constraint: "=&{rax}".
    INLINEASM &"mov $$1, $0", sideeffect attdialect, regdef-ec, implicit-def early-clobber $rax
    $rcx = MOV64rr $rax
    RET 0
...

---
name: asm_bookkeeping_def_to_native_input
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: asm_bookkeeping_def_to_native_input:%bb.0
  ; CHECK: SU(0): {{.*}}INLINEASM
  ; CHECK: SU(1): Data Latency=0 Reg=$rax
  bb.0:
    INLINEASM &"", attdialect, implicit-def $rax
    $rcx = MOV64rr $rax
    RET 0
...
