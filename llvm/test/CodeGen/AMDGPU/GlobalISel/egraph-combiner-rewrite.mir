    ; BASELINE-NEXT: SI_RETURN implicit $vgpr0_vgpr1
    %a:_(s64) = COPY $vgpr0_vgpr1
    %b:_(s64) = COPY $vgpr2_vgpr3
    %c:_(s64) = COPY $vgpr4_vgpr5
    %d:_(s64) = COPY $vgpr6_vgpr7
    %ab:_(s64) = G_ADD %a, %b
    %ba:_(s64) = G_ADD %b, %a
    %m1:_(s64) = G_MUL %ab, %c
    %m2:_(s64) = G_MUL %ba, %d
    %r:_(s64) = G_ADD %m1, %m2
    $vgpr0_vgpr1 = COPY %r
    SI_RETURN implicit $vgpr0_vgpr1
...
---
# a * 3 + a * 5 ==> a * 8 ==> a << 3
name: factor_constants_to_shift
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: factor_constants_to_shift
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 3
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(s32) = G_SHL %a, [[C]](s32)
    ; CHECK-NEXT: $vgpr0 = COPY [[SHL]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    ;
    ; BASELINE-LABEL: name: factor_constants_to_shift
    ; BASELINE: liveins: $vgpr0
    ; BASELINE-NEXT: {{  $}}
    ; BASELINE-NEXT: %a:_(s32) = COPY $vgpr0
    ; BASELINE-NEXT: %c3:_(s32) = G_CONSTANT i32 3
    ; BASELINE-NEXT: %c5:_(s32) = G_CONSTANT i32 5
    ; BASELINE-NEXT: %m1:_(s32) = G_MUL %a, %c3
    ; BASELINE-NEXT: %m2:_(s32) = G_MUL %a, %c5
    ; BASELINE-NEXT: %r:_(s32) = G_ADD %m1, %m2
    ; BASELINE-NEXT: $vgpr0 = COPY %r(s32)
    ; BASELINE-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %c3:_(s32) = G_CONSTANT i32 3
    %c5:_(s32) = G_CONSTANT i32 5
    %m1:_(s32) = G_MUL %a, %c3
    %m2:_(s32) = G_MUL %a, %c5
    %r:_(s32) = G_ADD %m1, %m2
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# ((a - b) + (c - a)) ==> c - b   (AMinusBPlusCMinusA in Combine.td)
name: a_minus_b_plus_c_minus_a
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-LABEL: name: a_minus_b_plus_c_minus_a
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: %c:_(s32) = COPY $vgpr2
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(s32) = G_SUB %c, %b
    ; CHECK-NEXT: $vgpr0 = COPY [[SUB]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    ;
    ; BASELINE-LABEL: name: a_minus_b_plus_c_minus_a
    ; BASELINE: liveins: $vgpr0, $vgpr1, $vgpr2
    ; BASELINE-NEXT: {{  $}}
    ; BASELINE-NEXT: %b:_(s32) = COPY $vgpr1
    ; BASELINE-NEXT: %c:_(s32) = COPY $vgpr2
    ; BASELINE-NEXT: %r:_(s32) = G_SUB %c, %b
    ; BASELINE-NEXT: $vgpr0 = COPY %r(s32)
    ; BASELINE-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c:_(s32) = COPY $vgpr2
    %s1:_(s32) = G_SUB %a, %b
    %s2:_(s32) = G_SUB %c, %a
    %r:_(s32) = G_ADD %s1, %s2
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# (a - b) + (b - c) + (c - a) ==> 0
# Each pairwise combine in Combine.td only sees two subtractions at a time.
name: telescoping_sum
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-LABEL: name: telescoping_sum
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: %c:_(s32) = COPY $vgpr2
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 0
    ; CHECK-NEXT: $vgpr0 = COPY [[C]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    ;
    ; BASELINE-LABEL: name: telescoping_sum
    ; BASELINE: liveins: $vgpr0, $vgpr1, $vgpr2
    ; BASELINE-NEXT: {{  $}}
    ; BASELINE-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 0
    ; BASELINE-NEXT: $vgpr0 = COPY [[C]](s32)
    ; BASELINE-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c:_(s32) = COPY $vgpr2
    %s1:_(s32) = G_SUB %a, %b
    %s2:_(s32) = G_SUB %b, %c
    %s3:_(s32) = G_SUB %c, %a
    %t:_(s32) = G_ADD %s1, %s2
    %r:_(s32) = G_ADD %t, %s3
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# ((a + 10) - 3) - b + 7 ==> (a - b) + 14
name: constant_reassociation
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: constant_reassociation
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(s32) = G_SUB %a, %b
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 14
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(s32) = G_ADD [[SUB]], [[C]]
    ; CHECK-NEXT: $vgpr0 = COPY [[ADD]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    ;
    ; BASELINE-LABEL: name: constant_reassociation
    ; BASELINE: liveins: $vgpr0, $vgpr1
    ; BASELINE-NEXT: {{  $}}
    ; BASELINE-NEXT: %a:_(s32) = COPY $vgpr0
    ; BASELINE-NEXT: %b:_(s32) = COPY $vgpr1
    ; BASELINE-NEXT: %c7:_(s32) = G_CONSTANT i32 7
    ; BASELINE-NEXT: %t1:_(s32) = G_ADD %a, %c7
    ; BASELINE-NEXT: %t2:_(s32) = G_SUB %t1, %b
    ; BASELINE-NEXT: %r:_(s32) = G_ADD %t2, %c7
    ; BASELINE-NEXT: $vgpr0 = COPY %r(s32)
    ; BASELINE-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c10:_(s32) = G_CONSTANT i32 10
    %c3:_(s32) = G_CONSTANT i32 3
    %c7:_(s32) = G_CONSTANT i32 7
    %t0:_(s32) = G_ADD %a, %c10
    %t1:_(s32) = G_SUB %t0, %c3
    %t2:_(s32) = G_SUB %t1, %b
    %r:_(s32) = G_ADD %t2, %c7
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# (a & b) | (a & c) ==> a & (b | c)
name: factor_and_or
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-LABEL: name: factor_and_or
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: %c:_(s32) = COPY $vgpr2
    ; CHECK-NEXT: [[OR:%[0-9]+]]:_(s32) = G_OR %b, %c
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(s32) = G_AND %a, [[OR]]
    ; CHECK-NEXT: $vgpr0 = COPY [[AND]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    ;
    ; BASELINE-LABEL: name: factor_and_or
    ; BASELINE: liveins: $vgpr0, $vgpr1, $vgpr2
    ; BASELINE-NEXT: {{  $}}
    ; BASELINE-NEXT: %a:_(s32) = COPY $vgpr0
    ; BASELINE-NEXT: %b:_(s32) = COPY $vgpr1
    ; BASELINE-NEXT: %c:_(s32) = COPY $vgpr2
    ; BASELINE-NEXT: %x:_(s32) = G_AND %a, %b
    ; BASELINE-NEXT: %y:_(s32) = G_AND %c, %a
    ; BASELINE-NEXT: %r:_(s32) = G_OR %x, %y
    ; BASELINE-NEXT: $vgpr0 = COPY %r(s32)
    ; BASELINE-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c:_(s32) = COPY $vgpr2
    %x:_(s32) = G_AND %a, %b
    %y:_(s32) = G_AND %c, %a
    %r:_(s32) = G_OR %x, %y
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# A value shared by two external users. %t = a + 0 is not used outside the
# region, so the region has two roots (%u and %v), which both simplify.
name: multi_root
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-LABEL: name: multi_root
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %c:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: %d:_(s32) = COPY $vgpr2
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(s32) = G_MUL %a, %c
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:_(s32) = G_XOR %a, %d
    ; CHECK-NEXT: $vgpr0 = COPY [[MUL]](s32)
    ; CHECK-NEXT: $vgpr1 = COPY [[XOR]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    ;
    ; BASELINE-LABEL: name: multi_root
    ; BASELINE: liveins: $vgpr0, $vgpr1, $vgpr2
    ; BASELINE-NEXT: {{  $}}
    ; BASELINE-NEXT: %a:_(s32) = COPY $vgpr0
    ; BASELINE-NEXT: %c:_(s32) = COPY $vgpr1
    ; BASELINE-NEXT: %d:_(s32) = COPY $vgpr2
    ; BASELINE-NEXT: %u:_(s32) = G_MUL %a, %c
    ; BASELINE-NEXT: %v:_(s32) = G_XOR %a, %d
    ; BASELINE-NEXT: $vgpr0 = COPY %u(s32)
    ; BASELINE-NEXT: $vgpr1 = COPY %v(s32)
    ; BASELINE-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %a:_(s32) = COPY $vgpr0
    %c:_(s32) = COPY $vgpr1
    %d:_(s32) = COPY $vgpr2
    %zero:_(s32) = G_CONSTANT i32 0
    %t:_(s32) = G_ADD %a, %zero
    %u:_(s32) = G_MUL %t, %c
    %v:_(s32) = G_XOR %t, %d
    $vgpr0 = COPY %u
    $vgpr1 = COPY %v
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...
---
# %ab is used outside the region, so it must stay available; the second root
# simplifies to %b.
name: shared_value_kept
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: shared_value_kept
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(s32) = G_ADD %a, %b
    ; CHECK-NEXT: $vgpr0 = COPY [[ADD]](s32)
    ; CHECK-NEXT: $vgpr1 = COPY %b(s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    ;
    ; BASELINE-LABEL: name: shared_value_kept
    ; BASELINE: liveins: $vgpr0, $vgpr1
    ; BASELINE-NEXT: {{  $}}
    ; BASELINE-NEXT: %a:_(s32) = COPY $vgpr0
    ; BASELINE-NEXT: %b:_(s32) = COPY $vgpr1
    ; BASELINE-NEXT: %ab:_(s32) = G_ADD %a, %b
    ; BASELINE-NEXT: $vgpr0 = COPY %ab(s32)
    ; BASELINE-NEXT: $vgpr1 = COPY %b(s32)
    ; BASELINE-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %ab:_(s32) = G_ADD %a, %b
    %r:_(s32) = G_SUB %ab, %a
    $vgpr0 = COPY %ab
    $vgpr1 = COPY %r
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...
---
# Nothing to gain: the region is left untouched.
name: not_profitable
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-LABEL: name: not_profitable
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: %c:_(s32) = COPY $vgpr2
    ; CHECK-NEXT: %x:_(s32) = G_ADD %a, %b
    ; CHECK-NEXT: %r:_(s32) = G_MUL %x, %c
    ; CHECK-NEXT: $vgpr0 = COPY %r(s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    ;
    ; BASELINE-LABEL: name: not_profitable
    ; BASELINE: liveins: $vgpr0, $vgpr1, $vgpr2
    ; BASELINE-NEXT: {{  $}}
    ; BASELINE-NEXT: %a:_(s32) = COPY $vgpr0
    ; BASELINE-NEXT: %b:_(s32) = COPY $vgpr1
    ; BASELINE-NEXT: %c:_(s32) = COPY $vgpr2
    ; BASELINE-NEXT: %x:_(s32) = G_ADD %a, %b
    ; BASELINE-NEXT: %r:_(s32) = G_MUL %x, %c
    ; BASELINE-NEXT: $vgpr0 = COPY %r(s32)
    ; BASELINE-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c:_(s32) = COPY $vgpr2
    %x:_(s32) = G_ADD %a, %b
    %r:_(s32) = G_MUL %x, %c
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# Flags are preserved on the instructions that are re-emitted; the flagged
# add is only replaced because dropping nsw is a refinement.
name: flags
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-LABEL: name: flags
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: %c:_(s32) = COPY $vgpr2
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(s32) = nuw G_MUL %a, %c
    ; CHECK-NEXT: $vgpr0 = COPY [[MUL]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    ;
    ; BASELINE-LABEL: name: flags
    ; BASELINE: liveins: $vgpr0, $vgpr1, $vgpr2
    ; BASELINE-NEXT: {{  $}}
    ; BASELINE-NEXT: %a:_(s32) = COPY $vgpr0
    ; BASELINE-NEXT: %c:_(s32) = COPY $vgpr2
    ; BASELINE-NEXT: %z:_(s32) = nuw G_MUL %a, %c
    ; BASELINE-NEXT: $vgpr0 = COPY %z(s32)
    ; BASELINE-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c:_(s32) = COPY $vgpr2
    %x:_(s32) = nsw G_ADD %a, %b
    %y:_(s32) = G_SUB %x, %b
    %z:_(s32) = nuw G_MUL %y, %c
    $vgpr0 = COPY %z
    SI_RETURN implicit $vgpr0
...
---
# Shifts by an out-of-range amount are poison and are never rewritten or
# folded.
name: shift_out_of_range
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: shift_out_of_range
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 40
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(s32) = G_SHL %a, [[C]](s32)
    ; CHECK-NEXT: $vgpr0 = COPY [[SHL]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    ;
    ; BASELINE-LABEL: name: shift_out_of_range
    ; BASELINE: liveins: $vgpr0
    ; BASELINE-NEXT: {{  $}}
    ; BASELINE-NEXT: %r:_(s32) = G_IMPLICIT_DEF
    ; BASELINE-NEXT: $vgpr0 = COPY %r(s32)
    ; BASELINE-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %c40:_(s32) = G_CONSTANT i32 40
    %c0:_(s32) = G_CONSTANT i32 0
    %x:_(s32) = G_SHL %a, %c40
    %r:_(s32) = G_ADD %x, %c0
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# x - x with an undef x: replacing it with 0 is a refinement, which is allowed
# when rewriting (but would not be allowed to merge e-classes).
name: undef_self_sub
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: undef_self_sub
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %u:_(s32) = G_IMPLICIT_DEF
    ; CHECK-NEXT: $vgpr0 = COPY %a(s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    ;
    ; BASELINE-LABEL: name: undef_self_sub
    ; BASELINE: liveins: $vgpr0
    ; BASELINE-NEXT: {{  $}}
    ; BASELINE-NEXT: %r:_(s32) = G_IMPLICIT_DEF
    ; BASELINE-NEXT: $vgpr0 = COPY %r(s32)
    ; BASELINE-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %u:_(s32) = G_IMPLICIT_DEF
    %x:_(s32) = G_SUB %u, %u
    %r:_(s32) = G_ADD %x, %a
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# Multi-block: regions never cross block boundaries; the value computed in
# bb.0 is an opaque input in bb.1.
name: multi_block
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: multi_block
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %a:_(s32) = COPY $vgpr0
  ; CHECK-NEXT:   %b:_(s32) = COPY $vgpr1
  ; CHECK-NEXT:   %x:_(s32) = G_ADD %a, %b
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   %r:_(s32) = G_SUB %x, %b
  ; CHECK-NEXT:   $vgpr0 = COPY %r(s32)
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  ;
  ; BASELINE-LABEL: name: multi_block
  ; BASELINE: bb.0:
  ; BASELINE-NEXT:   successors: %bb.1(0x80000000)
  ; BASELINE-NEXT:   liveins: $vgpr0, $vgpr1
  ; BASELINE-NEXT: {{  $}}
  ; BASELINE-NEXT:   %a:_(s32) = COPY $vgpr0
  ; BASELINE-NEXT:   G_BR %bb.1
  ; BASELINE-NEXT: {{  $}}
  ; BASELINE-NEXT: bb.1:
  ; BASELINE-NEXT:   $vgpr0 = COPY %a(s32)
  ; BASELINE-NEXT:   SI_RETURN implicit $vgpr0
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $vgpr1
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %x:_(s32) = G_ADD %a, %b
    G_BR %bb.1

  bb.1:
    %r:_(s32) = G_SUB %x, %b
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
