# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn-amd-amdhsa -run-pass=gisel-egraph-combiner -gisel-egraph-mode=rewrite %s -o - | FileCheck %s

# Rewrite mode of the experimental e-graph combiner for the remaining integer
# operators: minimum and maximum, operators with an overflow result, parts of
# a value, operators with an immediate operand, variants that can be poison,
# and G_FREEZE.

---
# select(a < b, a, b) ==> smin(a, b). G_SMIN is legal for s32.
name: select_to_smin
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: select_to_smin
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: [[SMIN:%[0-9]+]]:_(s32) = G_SMIN %a, %b
    ; CHECK-NEXT: $vgpr0 = COPY [[SMIN]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c:_(s1) = G_ICMP intpred(slt), %a, %b
    %r:_(s32) = G_SELECT %c, %a, %b
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# max(a, b) - min(a, b) is G_ABDU, but the legalizer expands G_ABDU again,
# so the region does not change.
name: abdu_is_not_introduced
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: abdu_is_not_introduced
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: %max:_(s32) = G_UMAX %a, %b
    ; CHECK-NEXT: %min:_(s32) = G_UMIN %a, %b
    ; CHECK-NEXT: %r:_(s32) = G_SUB %max, %min
    ; CHECK-NEXT: $vgpr0 = COPY %r(s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %max:_(s32) = G_UMAX %a, %b
    %min:_(s32) = G_UMIN %a, %b
    %r:_(s32) = G_SUB %max, %min
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# a + 0 does not overflow: both results of the G_UADDO fold.
name: uaddo_of_zero
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: uaddo_of_zero
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: $vgpr0 = COPY %a(s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %zero:_(s32) = G_CONSTANT i32 0
    %sum:_(s32), %carry:_(s1) = G_UADDO %a, %zero
    %ext:_(s32) = G_ZEXT %carry
    %r:_(s32) = G_ADD %sum, %ext
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# The operand of the G_UADDO is simplified. The two results stay results of
# one instruction.
name: uaddo_keeps_both_results
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: uaddo_keeps_both_results
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: [[UADDO:%[0-9]+]]:_(s32), [[UADDO1:%[0-9]+]]:_(s1) = G_UADDO %a, %b
    ; CHECK-NEXT: [[ZEXT:%[0-9]+]]:_(s32) = G_ZEXT [[UADDO1]](s1)
    ; CHECK-NEXT: $vgpr0 = COPY [[UADDO]](s32)
    ; CHECK-NEXT: $vgpr1 = COPY [[ZEXT]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %zero:_(s32) = G_CONSTANT i32 0
    %x:_(s32) = G_OR %a, %zero
    %sum:_(s32), %carry:_(s1) = G_UADDO %x, %b
    %ext:_(s32) = G_ZEXT %carry
    $vgpr0 = COPY %sum
    $vgpr1 = COPY %ext
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...
---
# The sum of a G_UADDO is a G_ADD, so (a + b) - b ==> a.
name: uaddo_sum_only
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: uaddo_sum_only
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: $vgpr0 = COPY %a(s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %sum:_(s32), %carry:_(s1) = G_UADDO %a, %b
    %r:_(s32) = G_SUB %sum, %b
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# The borrow of a - b is a < b, so the select is a minimum.
name: usubo_borrow_only
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: usubo_borrow_only
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: [[UMIN:%[0-9]+]]:_(s32) = G_UMIN %a, %b
    ; CHECK-NEXT: $vgpr0 = COPY [[UMIN]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %diff:_(s32), %borrow:_(s1) = G_USUBO %a, %b
    %r:_(s32) = G_SELECT %borrow, %a, %b
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# A carry operand of 0: G_UADDE is G_UADDO, and a + 0 does not overflow.
name: uadde_without_carry
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: uadde_without_carry
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(s32) = G_AND %a, %b
    ; CHECK-NEXT: $vgpr0 = COPY [[AND]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %false:_(s1) = G_CONSTANT i1 false
    %zero:_(s32) = G_CONSTANT i32 0
    %sum:_(s32), %carry:_(s1) = G_UADDE %a, %zero, %false
    %ext:_(s32) = G_ZEXT %carry
    %x:_(s32) = G_OR %sum, %ext
    %r:_(s32) = G_AND %x, %b
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# The parts of a concatenation are its operands.
name: unmerge_of_merge
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: unmerge_of_merge
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: [[SUB:%[0-9]+]]:_(s32) = G_SUB %b, %a
    ; CHECK-NEXT: $vgpr0 = COPY [[SUB]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %m:_(s64) = G_MERGE_VALUES %a, %b
    %lo:_(s32), %hi:_(s32) = G_UNMERGE_VALUES %m
    %r:_(s32) = G_SUB %hi, %lo
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# The concatenation of all the parts of a value is the value.
name: merge_of_unmerge
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: merge_of_unmerge
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: %x:_(s64) = G_MERGE_VALUES %a(s32), %b(s32)
    ; CHECK-NEXT: %y:_(s64) = G_FREEZE %x
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s64) = G_CONSTANT i64 1
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(s64) = G_SHL %y, [[C]](s64)
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(s32), [[UV1:%[0-9]+]]:_(s32) = G_UNMERGE_VALUES [[SHL]](s64)
    ; CHECK-NEXT: $vgpr0 = COPY [[UV]](s32)
    ; CHECK-NEXT: $vgpr1 = COPY [[UV1]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %x:_(s64) = G_MERGE_VALUES %a, %b
    %y:_(s64) = G_FREEZE %x
    %lo:_(s32), %hi:_(s32) = G_UNMERGE_VALUES %y
    %m:_(s64) = G_MERGE_VALUES %lo, %hi
    %r:_(s64) = G_ADD %m, %y
    %r0:_(s32), %r1:_(s32) = G_UNMERGE_VALUES %r
    $vgpr0 = COPY %r0
    $vgpr1 = COPY %r1
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...
---
# Both parts of a value are used: one G_UNMERGE_VALUES with two results.
name: unmerge_keeps_both_results
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: unmerge_keeps_both_results
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: %x:_(s64) = G_MERGE_VALUES %a(s32), %b(s32)
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(s64) = G_MUL %x, %x
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(s32), [[UV1:%[0-9]+]]:_(s32) = G_UNMERGE_VALUES [[MUL]](s64)
    ; CHECK-NEXT: $vgpr0 = COPY [[UV]](s32)
    ; CHECK-NEXT: $vgpr1 = COPY [[UV1]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %x:_(s64) = G_MERGE_VALUES %a, %b
    %one:_(s64) = G_CONSTANT i64 1
    %y:_(s64) = G_ADD %x, %one
    %z:_(s64) = G_SUB %y, %one
    %s:_(s64) = G_MUL %z, %z
    %lo:_(s32), %hi:_(s32) = G_UNMERGE_VALUES %s
    $vgpr0 = COPY %lo
    $vgpr1 = COPY %hi
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...
---
# The immediate of G_SEXT_INREG is part of the operation.
name: sext_inreg_immediate
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: sext_inreg_immediate
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %a:_(s32) = G_SEXT_INREG %x, 8
    ; CHECK-NEXT: %c:_(s32) = G_SEXT_INREG %x, 16
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:_(s32) = G_XOR %c, %a
    ; CHECK-NEXT: $vgpr0 = COPY [[XOR]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %x:_(s32) = COPY $vgpr0
    %a:_(s32) = G_SEXT_INREG %x, 8
    %b:_(s32) = G_SEXT_INREG %x, 8
    %c:_(s32) = G_SEXT_INREG %x, 16
    %and:_(s32) = G_AND %a, %b
    %r:_(s32) = G_XOR %and, %c
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# G_CTLZ_ZERO_POISON stays the variant that can be poison.
name: ctlz_zero_poison_is_kept
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: ctlz_zero_poison_is_kept
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: [[CTLZ_ZERO_POISON:%[0-9]+]]:_(s32) = G_CTLZ_ZERO_POISON %x(s32)
    ; CHECK-NEXT: $vgpr0 = COPY [[CTLZ_ZERO_POISON]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %x:_(s32) = COPY $vgpr0
    %r1:_(s32) = G_BITREVERSE %x
    %r2:_(s32) = G_BITREVERSE %r1
    %n:_(s32) = G_CTLZ_ZERO_POISON %r2
    $vgpr0 = COPY %n
    SI_RETURN implicit $vgpr0
...
---
# A frozen value is neither undef nor poison, so x - x of it is exactly 0.
# The freeze of a constant is the constant.
name: freeze
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: freeze
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: %seven:_(s32) = G_CONSTANT i32 7
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(s32) = G_ADD %b, %seven
    ; CHECK-NEXT: $vgpr0 = COPY [[ADD]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %f:_(s32) = G_FREEZE %a
    %d:_(s32) = G_SUB %f, %f
    %seven:_(s32) = G_CONSTANT i32 7
    %g:_(s32) = G_FREEZE %seven
    %s:_(s32) = G_ADD %d, %g
    %r:_(s32) = G_ADD %s, %b
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# A funnel shift by 0 is its first operand.
name: fshl_by_zero
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: fshl_by_zero
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(s32) = G_ADD %b, %a
    ; CHECK-NEXT: $vgpr0 = COPY [[ADD]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %zero:_(s32) = G_CONSTANT i32 0
    %f:_(s32) = G_FSHL %a, %b, %zero
    %r:_(s32) = G_ADD %f, %b
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# Saturating and unsigned minimum identities.
name: saturating_identities
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: saturating_identities
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: [[SMAX:%[0-9]+]]:_(s32) = G_SMAX %a, %b
    ; CHECK-NEXT: $vgpr0 = COPY [[SMAX]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %zero:_(s32) = G_CONSTANT i32 0
    %ones:_(s32) = G_CONSTANT i32 -1
    %s:_(s32) = G_UADDSAT %a, %zero
    %m:_(s32) = G_UMIN %s, %ones
    %n:_(s32) = G_UMAX %m, %m
    %r:_(s32) = G_SMAX %n, %b
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# select(a < 0, -a, a) ==> abs(a)
name: abs_from_select
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: abs_from_select
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: [[ABS:%[0-9]+]]:_(s32) = G_ABS %a
    ; CHECK-NEXT: $vgpr0 = COPY [[ABS]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %zero:_(s32) = G_CONSTANT i32 0
    %neg:_(s32) = G_SUB %zero, %a
    %c:_(s1) = G_ICMP intpred(slt), %a, %zero
    %r:_(s32) = G_SELECT %c, %neg, %a
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# A bit field of a constant position is a shift and a mask, so the second
# mask is redundant.
name: ubfx_and_mask
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: ubfx_and_mask
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %lsb:_(s32) = G_CONSTANT i32 4
    ; CHECK-NEXT: %width:_(s32) = G_CONSTANT i32 8
    ; CHECK-NEXT: %f:_(s32) = G_UBFX %x, %lsb(s32), %width
    ; CHECK-NEXT: $vgpr0 = COPY %f(s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %x:_(s32) = COPY $vgpr0
    %lsb:_(s32) = G_CONSTANT i32 4
    %width:_(s32) = G_CONSTANT i32 8
    %f:_(s32) = G_UBFX %x, %lsb, %width
    %mask:_(s32) = G_CONSTANT i32 255
    %r:_(s32) = G_AND %f, %mask
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# inttoptr(ptrtoint(p)) with an integer of the width of the pointer is p.
name: pointer_round_trip
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: pointer_round_trip
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %lo:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %hi:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: %m:_(s64) = G_MERGE_VALUES %lo(s32), %hi(s32)
    ; CHECK-NEXT: %p:_(p0) = G_INTTOPTR %m(s64)
    ; CHECK-NEXT: %eight:_(s64) = G_CONSTANT i64 8
    ; CHECK-NEXT: [[PTR_ADD:%[0-9]+]]:_(p0) = G_PTR_ADD %p, %eight(s64)
    ; CHECK-NEXT: [[PTRTOINT:%[0-9]+]]:_(s64) = G_PTRTOINT [[PTR_ADD]](p0)
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(s32), [[UV1:%[0-9]+]]:_(s32) = G_UNMERGE_VALUES [[PTRTOINT]](s64)
    ; CHECK-NEXT: $vgpr0 = COPY [[UV]](s32)
    ; CHECK-NEXT: $vgpr1 = COPY [[UV1]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %lo:_(s32) = COPY $vgpr0
    %hi:_(s32) = COPY $vgpr1
    %m:_(s64) = G_MERGE_VALUES %lo, %hi
    %p:_(p0) = G_INTTOPTR %m
    %i:_(s64) = G_PTRTOINT %p
    %q:_(p0) = G_INTTOPTR %i
    %eight:_(s64) = G_CONSTANT i64 8
    %r:_(p0) = G_PTR_ADD %q, %eight
    %ri:_(s64) = G_PTRTOINT %r
    %r0:_(s32), %r1:_(s32) = G_UNMERGE_VALUES %ri
    $vgpr0 = COPY %r0
    $vgpr1 = COPY %r1
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...
