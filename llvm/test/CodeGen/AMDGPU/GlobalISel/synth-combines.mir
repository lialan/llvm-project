    ; OFF-NEXT: %b:_(s64) = COPY $vgpr2_vgpr3
    ; OFF-NEXT: %c:_(s64) = COPY $vgpr4_vgpr5
    ; OFF-NEXT: %t0:_(s64) = G_ADD %a, %b
    ; OFF-NEXT: %t1:_(s64) = G_ADD %c, %a
    ; OFF-NEXT: %r:_(s64) = G_SUB %t0, %t1
