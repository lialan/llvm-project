; SDAG-LABEL: add_phi_cycle:
; SDAG:       ; %bb.0: ; %entry
; SDAG-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
; SDAG-NEXT:    s_add_i32 s2, s0, 16
; SDAG-NEXT:    s_mov_b32 s0, 0
; SDAG-NEXT:  .LBB12_1: ; %loop
; SDAG-NEXT:    ; =>This Inner Loop Header: Depth=1
; SDAG-NEXT:    s_delay_alu instid0(SALU_CYCLE_1) | instskip(NEXT) | instid1(SALU_CYCLE_1)
; SDAG-NEXT:    s_add_i32 s0, s0, s2
; SDAG-NEXT:    s_cmp_lt_u32 s0, s1
; SDAG-NEXT:    s_cbranch_scc1 .LBB12_1
; SDAG-NEXT:  ; %bb.2: ; %exit
; SDAG-NEXT:    v_mov_b32_e32 v0, s0
; SDAG-NEXT:    s_setpc_b64 s[30:31]
;
; GISEL-LABEL: add_phi_cycle:
; GISEL:       ; %bb.0: ; %entry
; GISEL-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
; GISEL-NEXT:    s_mov_b32 s2, 0
; GISEL-NEXT:  .LBB12_1: ; %loop
; GISEL-NEXT:    ; =>This Inner Loop Header: Depth=1
; GISEL-NEXT:    s_delay_alu instid0(SALU_CYCLE_1) | instskip(NEXT) | instid1(SALU_CYCLE_1)
; GISEL-NEXT:    s_add_i32 s2, s0, s2
; GISEL-NEXT:    s_add_i32 s2, s2, 16
; GISEL-NEXT:    s_delay_alu instid0(SALU_CYCLE_1)
; GISEL-NEXT:    s_cmp_lt_u32 s2, s1
; GISEL-NEXT:    s_cbranch_scc1 .LBB12_1
; GISEL-NEXT:  ; %bb.2: ; %exit
; GISEL-NEXT:    v_mov_b32_e32 v0, s2
; GISEL-NEXT:    s_setpc_b64 s[30:31]
entry:
