    %two:_(s32) = G_CONSTANT i32 2
    %s:_(s32) = G_SELECT %c, %one, %two
    %e:_(s1) = G_ICMP intpred(eq), %s, %one
    %r:_(s32) = G_ZEXT %e
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# a u/ 8 ==> a >> 3, and a u% 8 ==> a & 7.
name: division_by_power_of_two
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: division_by_power_of_two
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 3
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(s32) = G_LSHR %a, [[C]](s32)
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(s32) = G_CONSTANT i32 7
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(s32) = G_AND %a, [[C1]]
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:_(s32) = G_XOR [[LSHR]], [[AND]]
    ; CHECK-NEXT: $vgpr0 = COPY [[XOR]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %eight:_(s32) = G_CONSTANT i32 8
    %q:_(s32) = G_UDIV %a, %eight
    %m:_(s32) = G_UREM %a, %eight
    %r:_(s32) = G_XOR %q, %m
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# a - (a u/ b) * b ==> a u% b. The remainder traps exactly when the division
# does.
name: remainder_from_division
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: remainder_from_division
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: [[UREM:%[0-9]+]]:_(s32) = G_UREM %a, %b
    ; CHECK-NEXT: $vgpr0 = COPY [[UREM]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %q:_(s32) = G_UDIV %a, %b
    %m:_(s32) = G_MUL %q, %b
    %r:_(s32) = G_SUB %a, %m
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# A division that may trap is never introduced: nothing to do here.
name: division_kept
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: division_kept
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: %q:_(s32) = G_SDIV %a, %b
    ; CHECK-NEXT: %r:_(s32) = G_ADD %q, %a
    ; CHECK-NEXT: $vgpr0 = COPY %r(s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %q:_(s32) = G_SDIV %a, %b
    %r:_(s32) = G_ADD %q, %a
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# (p + 4) + 8 ==> p + 12
name: pointer_arithmetic
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    ; CHECK-LABEL: name: pointer_arithmetic
    ; CHECK: liveins: $vgpr0_vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %p:_(p0) = COPY $vgpr0_vgpr1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s64) = G_CONSTANT i64 12
    ; CHECK-NEXT: [[PTR_ADD:%[0-9]+]]:_(p0) = G_PTR_ADD %p, [[C]](s64)
    ; CHECK-NEXT: $vgpr0_vgpr1 = COPY [[PTR_ADD]](p0)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0_vgpr1
    %p:_(p0) = COPY $vgpr0_vgpr1
    %four:_(s64) = G_CONSTANT i64 4
    %eight:_(s64) = G_CONSTANT i64 8
    %q:_(p0) = G_PTR_ADD %p, %four
    %r:_(p0) = G_PTR_ADD %q, %eight
    $vgpr0_vgpr1 = COPY %r
    SI_RETURN implicit $vgpr0_vgpr1
...
---
# A PHI of the same constant on every edge is that constant, and a PHI of
# one value is that value.
name: phi_of_one_value
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: phi_of_one_value
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %a:_(s32) = COPY $vgpr0
  ; CHECK-NEXT:   %x:_(s32) = COPY $vgpr1
  ; CHECK-NEXT:   %c:_(s1) = G_TRUNC %x(s32)
  ; CHECK-NEXT:   G_BRCOND %c(s1), %bb.1
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   G_BR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   G_BR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 5
  ; CHECK-NEXT:   [[ADD:%[0-9]+]]:_(s32) = G_ADD %a, [[C]]
  ; CHECK-NEXT:   $vgpr0 = COPY [[ADD]](s32)
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $vgpr0, $vgpr1
    %a:_(s32) = COPY $vgpr0
    %x:_(s32) = COPY $vgpr1
    %c:_(s1) = G_TRUNC %x
    G_BRCOND %c, %bb.1
    G_BR %bb.2

  bb.1:
    successors: %bb.3
    %k1:_(s32) = G_CONSTANT i32 5
    G_BR %bb.3

  bb.2:
    successors: %bb.3
    %k2:_(s32) = G_CONSTANT i32 5
    G_BR %bb.3

  bb.3:
    %p:_(s32) = G_PHI %k1, %bb.1, %k2, %bb.2
    %q:_(s32) = G_PHI %a, %bb.1, %a, %bb.2
    %r:_(s32) = G_ADD %p, %q
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
# A PHI with different incoming values is kept; its users are still
# simplified.
name: phi_kept
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: phi_kept
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1, $vgpr2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %a:_(s32) = COPY $vgpr0
  ; CHECK-NEXT:   %b:_(s32) = COPY $vgpr1
  ; CHECK-NEXT:   %x:_(s32) = COPY $vgpr2
  ; CHECK-NEXT:   %c:_(s1) = G_TRUNC %x(s32)
  ; CHECK-NEXT:   G_BRCOND %c(s1), %bb.1
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   %p:_(s32) = G_PHI %a(s32), %bb.0, %b(s32), %bb.1
  ; CHECK-NEXT:   $vgpr0 = COPY %p(s32)
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $vgpr0, $vgpr1, $vgpr2
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %x:_(s32) = COPY $vgpr2
    %c:_(s1) = G_TRUNC %x
    G_BRCOND %c, %bb.1
    G_BR %bb.2

  bb.1:
    successors: %bb.2

  bb.2:
    %p:_(s32) = G_PHI %a, %bb.0, %b, %bb.1
    %zero:_(s32) = G_CONSTANT i32 0
    %s:_(s32) = G_ADD %p, %zero
    %r:_(s32) = G_SUB %s, %p
    %t:_(s32) = G_OR %r, %p
    $vgpr0 = COPY %t
    SI_RETURN implicit $vgpr0
...
---
# A loop: the incoming value of the PHI from the loop itself is the value of
# the previous iteration. %n == %i + 0 is replaced by %i in the PHI.
name: phi_in_loop
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: phi_in_loop
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %a:_(s32) = COPY $vgpr0
  ; CHECK-NEXT:   %x:_(s32) = COPY $vgpr1
  ; CHECK-NEXT:   %c:_(s1) = G_TRUNC %x(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %i:_(s32) = G_PHI %a(s32), %bb.0, %i(s32), %bb.1
  ; CHECK-NEXT:   G_BRCOND %c(s1), %bb.1
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $vgpr0 = COPY %i(s32)
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $vgpr1
    %a:_(s32) = COPY $vgpr0
    %x:_(s32) = COPY $vgpr1
    %c:_(s1) = G_TRUNC %x

  bb.1:
    successors: %bb.1, %bb.2
    %i:_(s32) = G_PHI %a, %bb.0, %n, %bb.1
    %zero:_(s32) = G_CONSTANT i32 0
    %n:_(s32) = G_ADD %i, %zero
    G_BRCOND %c, %bb.1
    G_BR %bb.2

  bb.2:
    $vgpr0 = COPY %n
    SI_RETURN implicit $vgpr0
...
---
# br !c, T, F ==> br c, F, T
