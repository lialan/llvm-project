    ; CHECK-NEXT: %x:_(s32) = G_XOR %a, %u
    ; CHECK-NEXT: %y:_(s32) = G_XOR %u, %b
    ; CHECK-NEXT: %r:_(s32) = G_XOR %x, %y
    ; CHECK-NEXT: $vgpr0 = COPY %r(s32)
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %u:_(s32) = G_IMPLICIT_DEF
    %x:_(s32) = G_XOR %a, %u
    %y:_(s32) = G_XOR %u, %b
    %r:_(s32) = G_XOR %x, %y
    $vgpr0 = COPY %r
...

# The masks are merged but both uses of the undefined value stay:
# ((u & a) & (u & 7)) & 3 -> ((u & a) & u) & 3
---
name: and_undef_not_merged
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: and_undef_not_merged
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %u:_(s32) = G_IMPLICIT_DEF
    ; CHECK-NEXT: %c3:_(s32) = G_CONSTANT i32 3
    ; CHECK-NEXT: %x:_(s32) = G_AND %u, %a
    ; CHECK-NEXT: [[AND:%[0-9]+]]:_(s32) = G_AND %x, %u
    ; CHECK-NEXT: %r:_(s32) = G_AND [[AND]], %c3
    ; CHECK-NEXT: $vgpr0 = COPY %r(s32)
    %a:_(s32) = COPY $vgpr0
    %u:_(s32) = G_IMPLICIT_DEF
    %c7:_(s32) = G_CONSTANT i32 7
    %c3:_(s32) = G_CONSTANT i32 3
    %x:_(s32) = G_AND %u, %a
    %y:_(s32) = G_AND %u, %c7
    %s:_(s32) = G_AND %x, %y
    %r:_(s32) = G_AND %s, %c3
    $vgpr0 = COPY %r
...

