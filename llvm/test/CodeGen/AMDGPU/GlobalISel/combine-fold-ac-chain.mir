    %b:_(s32) = COPY $vgpr1
    %c:_(s32) = COPY $vgpr2
    %x:_(s32) = G_XOR %a, %b
    %y:_(s32) = G_XOR %a, %c
    %r:_(s32) = G_XOR %x, %y
    $vgpr0 = COPY %r
...

