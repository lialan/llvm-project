---
# A double has every s16.
name: fpext_of_sitofp
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: fpext_of_sitofp
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %a:_(i16) = G_TRUNC [[COPY]](i32)
    ; CHECK-NEXT: [[SITOFP:%[0-9]+]]:_(f64) = G_SITOFP %a(i16)
    ; CHECK-NEXT: [[UV:%[0-9]+]]:_(i32), [[UV1:%[0-9]+]]:_(i32) = G_UNMERGE_VALUES [[SITOFP]](f64)
    ; CHECK-NEXT: $vgpr0 = COPY [[UV]](i32)
    ; CHECK-NEXT: $vgpr1 = COPY [[UV1]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %0:_(i32) = COPY $vgpr0
    %a:_(i16) = G_TRUNC %0
    %b:_(f32) = G_SITOFP %a
    %c:_(f64) = G_FPEXT %b
    %lo:_(i32), %hi:_(i32) = G_UNMERGE_VALUES %c
    $vgpr0 = COPY %lo
    $vgpr1 = COPY %hi
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...
---
# Conversions of constants. -1.0 has no unsigned value: G_FPTOUI of it is
# poison and stays, and the saturating conversion gives 0.
name: fold_constants
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: fold_constants
    ; CHECK: [[C:%[0-9]+]]:_(f32) = G_FCONSTANT float -3.000000e+00
    ; CHECK-NEXT: $vgpr0 = COPY [[C]](f32)
    ; CHECK-NEXT: %h:_(f32) = G_FCONSTANT float 2.500000e+00
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 2
    ; CHECK-NEXT: $vgpr1 = COPY [[C1]](i32)
    ; CHECK-NEXT: %m:_(f32) = G_FCONSTANT float -1.000000e+00
    ; CHECK-NEXT: %u:_(i32) = G_FPTOUI %m(f32)
    ; CHECK-NEXT: $vgpr2 = COPY %u(i32)
    ; CHECK-NEXT: [[C2:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; CHECK-NEXT: $vgpr3 = COPY [[C2]](i32)
    ; CHECK-NEXT: $vgpr4 = COPY %h(f32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1, implicit $vgpr2, implicit $vgpr3, implicit $vgpr4
    %i:_(i32) = G_CONSTANT i32 -3
    %f:_(f32) = G_SITOFP %i
    $vgpr0 = COPY %f
    %h:_(f32) = G_FCONSTANT float 2.500000e+00
    %t:_(i32) = G_FPTOSI %h
    $vgpr1 = COPY %t
    %m:_(f32) = G_FCONSTANT float -1.000000e+00
    %u:_(i32) = G_FPTOUI %m
    $vgpr2 = COPY %u
    %s:_(i32) = G_FPTOUI_SAT %m
    $vgpr3 = COPY %s
    %d:_(f64) = G_FPEXT %h
    %x:_(f32) = G_FPTRUNC %d
    $vgpr4 = COPY %x
    SI_RETURN implicit $vgpr0, implicit $vgpr1, implicit $vgpr2, implicit $vgpr3, implicit $vgpr4
...
---
# The result of G_FREEZE is not poison: the second G_FREEZE is not necessary.
name: freeze_of_freeze_float
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: freeze_of_freeze_float
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(f32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(f32) = G_FREEZE %a
    ; CHECK-NEXT: $vgpr0 = COPY %b(f32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(f32) = COPY $vgpr0
    %b:_(f32) = G_FREEZE %a
    %c:_(f32) = G_FREEZE %b
    $vgpr0 = COPY %c
    SI_RETURN implicit $vgpr0
...
---
# G_SITOFP of a value that is not poison is not poison.
name: freeze_of_conversion
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: freeze_of_conversion
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(i32) = G_FREEZE %a
    ; CHECK-NEXT: %c:_(f32) = G_SITOFP %b(i32)
    ; CHECK-NEXT: $vgpr0 = COPY %c(f32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(i32) = COPY $vgpr0
    %b:_(i32) = G_FREEZE %a
    %c:_(f32) = G_SITOFP %b
    %d:_(f32) = G_FREEZE %c
    $vgpr0 = COPY %d
    SI_RETURN implicit $vgpr0
...
---
# G_FPTOSI can give poison for an operand that is not poison: G_FREEZE stays.
name: freeze_of_fptosi
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: freeze_of_fptosi
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(f32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(f32) = G_FREEZE %a
    ; CHECK-NEXT: %c:_(i32) = G_FPTOSI %b(f32)
    ; CHECK-NEXT: %d:_(i32) = G_FREEZE %c
    ; CHECK-NEXT: $vgpr0 = COPY %d(i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    %a:_(f32) = COPY $vgpr0
    %b:_(f32) = G_FREEZE %a
    %c:_(i32) = G_FPTOSI %b
    %d:_(i32) = G_FREEZE %c
    $vgpr0 = COPY %d
    SI_RETURN implicit $vgpr0
...
