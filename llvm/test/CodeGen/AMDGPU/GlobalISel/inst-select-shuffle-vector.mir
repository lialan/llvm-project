    ; GFX90A-NEXT: [[V_PK_MOV_B32_:%[0-9]+]]:vreg_64_align2 = V_PK_MOV_B32 12, [[COPY]], 8, [[COPY]], 0, 0, 0, 0, 0, implicit $exec
    ; GFX90A-NEXT: $vgpr0_vgpr1 = COPY [[V_PK_MOV_B32_]]
    %0:vgpr(<2 x s32>) = COPY $vgpr0_vgpr1
    %1:vgpr(<2 x s32>) = G_IMPLICIT_DEF
    %2:vgpr(<2 x s32>) = G_SHUFFLE_VECTOR %0, %1, shufflemask(1, 0)
    $vgpr0_vgpr1 = COPY %2
...

