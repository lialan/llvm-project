    successors: %bb.1, %bb.2
    liveins: $vgpr0, $vgpr1, $vgpr2
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %x:_(s32) = COPY $vgpr2
    %c:_(s1) = G_TRUNC %x
    %true:_(s1) = G_CONSTANT i1 true
    %n:_(s1) = G_XOR %c, %true
    G_BRCOND %n, %bb.1
    G_BR %bb.2

  bb.1:
    $vgpr0 = COPY %a
    SI_RETURN implicit $vgpr0

  bb.2:
    $vgpr0 = COPY %b
    SI_RETURN implicit $vgpr0
...
---
# A negated comparison in a branch becomes the inverse comparison.
name: branch_on_not_icmp
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: branch_on_not_icmp
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %a:_(s32) = COPY $vgpr0
  ; CHECK-NEXT:   %b:_(s32) = COPY $vgpr1
  ; CHECK-NEXT:   [[ICMP:%[0-9]+]]:_(s1) = G_ICMP intpred(sge), %a(s32), %b
  ; CHECK-NEXT:   G_BRCOND [[ICMP]](s1), %bb.1
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   $vgpr0 = COPY %a(s32)
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $vgpr0 = COPY %b(s32)
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $vgpr0, $vgpr1
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c:_(s1) = G_ICMP intpred(slt), %a, %b
    %true:_(s1) = G_CONSTANT i1 true
    %n:_(s1) = G_XOR %c, %true
    G_BRCOND %n, %bb.1
    G_BR %bb.2

  bb.1:
    $vgpr0 = COPY %a
    SI_RETURN implicit $vgpr0

  bb.2:
    $vgpr0 = COPY %b
    SI_RETURN implicit $vgpr0
...
---
# Without an unconditional branch the targets cannot be exchanged, and the
# negation of an opaque condition stays.
name: branch_on_not_fallthrough
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: branch_on_not_fallthrough
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1, $vgpr2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %a:_(s32) = COPY $vgpr0
  ; CHECK-NEXT:   %b:_(s32) = COPY $vgpr1
  ; CHECK-NEXT:   %x:_(s32) = COPY $vgpr2
  ; CHECK-NEXT:   %c:_(s1) = G_TRUNC %x(s32)
  ; CHECK-NEXT:   %true:_(s1) = G_CONSTANT i1 true
  ; CHECK-NEXT:   %n:_(s1) = G_XOR %c, %true
  ; CHECK-NEXT:   G_BRCOND %n(s1), %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   $vgpr0 = COPY %a(s32)
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $vgpr0 = COPY %b(s32)
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $vgpr0, $vgpr1, $vgpr2
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %x:_(s32) = COPY $vgpr2
    %c:_(s1) = G_TRUNC %x
    %true:_(s1) = G_CONSTANT i1 true
    %n:_(s1) = G_XOR %c, %true
    G_BRCOND %n, %bb.2

  bb.1:
    $vgpr0 = COPY %a
    SI_RETURN implicit $vgpr0

  bb.2:
    $vgpr0 = COPY %b
    SI_RETURN implicit $vgpr0
...
