    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 16
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(s32) = G_ADD %a, %b
    ; CHECK-NEXT: %r:_(s32) = G_ADD [[ADD]], [[C]]
    ; CHECK-NEXT: $vgpr0 = COPY %r(s32)
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c7:_(s32) = G_CONSTANT i32 7
    %c9:_(s32) = G_CONSTANT i32 9
    %x:_(s32) = G_ADD %a, %c7
    %y:_(s32) = G_ADD %x, %b
    %r:_(s32) = nuw nsw G_ADD %y, %c9
    $vgpr0 = COPY %r
...

# Another opcode is a leaf: ((a - b) + 7) + 9 -> (a - b) + 16
---
name: add_other_opcode_leaf
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: add_other_opcode_leaf
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: %d:_(s32) = G_SUB %a, %b
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 16
    ; CHECK-NEXT: %y:_(s32) = G_ADD %d, [[C]]
    ; CHECK-NEXT: $vgpr0 = COPY %y(s32)
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c7:_(s32) = G_CONSTANT i32 7
    %c9:_(s32) = G_CONSTANT i32 9
    %d:_(s32) = G_SUB %a, %b
    %x:_(s32) = G_ADD %d, %c7
    %y:_(s32) = G_ADD %x, %c9
    $vgpr0 = COPY %y
...

# A value from another block is a leaf.
---
name: add_other_block_leaf
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: add_other_block_leaf
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %a:_(s32) = COPY $vgpr0
  ; CHECK-NEXT:   %b:_(s32) = COPY $vgpr1
  ; CHECK-NEXT:   %c7:_(s32) = G_CONSTANT i32 7
  ; CHECK-NEXT:   %c9:_(s32) = G_CONSTANT i32 9
  ; CHECK-NEXT:   %x:_(s32) = G_ADD %a, %c7
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   %y:_(s32) = G_ADD %x, %b
  ; CHECK-NEXT:   %r:_(s32) = G_ADD %y, %c9
  ; CHECK-NEXT:   $vgpr0 = COPY %r(s32)
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $vgpr1
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c7:_(s32) = G_CONSTANT i32 7
    %c9:_(s32) = G_CONSTANT i32 9
    %x:_(s32) = G_ADD %a, %c7
    G_BR %bb.1

  bb.1:
    %y:_(s32) = G_ADD %x, %b
    %r:_(s32) = G_ADD %y, %c9
    $vgpr0 = COPY %r
...

# The shared inner sum %x stays a leaf. When the walk flattens through it
# (SHARED), a + 16 would still need one G_ADD while %x stays for its other
# user, so nothing is gained and nothing changes.
---
name: add_shared_inner_sum
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: add_shared_inner_sum
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %c7:_(s32) = G_CONSTANT i32 7
    ; CHECK-NEXT: %c9:_(s32) = G_CONSTANT i32 9
    ; CHECK-NEXT: %x:_(s32) = G_ADD %a, %c7
    ; CHECK-NEXT: %r:_(s32) = G_ADD %x, %c9
    ; CHECK-NEXT: $vgpr0 = COPY %r(s32)
    ; CHECK-NEXT: $vgpr1 = COPY %x(s32)
    %a:_(s32) = COPY $vgpr0
    %c7:_(s32) = G_CONSTANT i32 7
    %c9:_(s32) = G_CONSTANT i32 9
    %x:_(s32) = G_ADD %a, %c7
    %r:_(s32) = G_ADD %x, %c9
    $vgpr0 = COPY %r
    $vgpr1 = COPY %x
...

# Through the shared %s (SHARED), ((a ^ b) ^ c) ^ a -> b ^ c deletes two
# G_XORs and adds one, while %s stays for its other user.
---
name: xor_shared_inner
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2
    ; DEFAULT-LABEL: name: xor_shared_inner
    ; DEFAULT: liveins: $vgpr0, $vgpr1, $vgpr2
    ; DEFAULT-NEXT: {{  $}}
    ; DEFAULT-NEXT: %a:_(s32) = COPY $vgpr0
    ; DEFAULT-NEXT: %b:_(s32) = COPY $vgpr1
    ; DEFAULT-NEXT: %c:_(s32) = COPY $vgpr2
    ; DEFAULT-NEXT: %s:_(s32) = G_XOR %a, %b
    ; DEFAULT-NEXT: %t:_(s32) = G_XOR %s, %c
    ; DEFAULT-NEXT: %r:_(s32) = G_XOR %t, %a
    ; DEFAULT-NEXT: $vgpr0 = COPY %r(s32)
    ; DEFAULT-NEXT: $vgpr1 = COPY %s(s32)
    ;
    ; SHARED-LABEL: name: xor_shared_inner
    ; SHARED: liveins: $vgpr0, $vgpr1, $vgpr2
    ; SHARED-NEXT: {{  $}}
    ; SHARED-NEXT: %a:_(s32) = COPY $vgpr0
    ; SHARED-NEXT: %b:_(s32) = COPY $vgpr1
    ; SHARED-NEXT: %c:_(s32) = COPY $vgpr2
    ; SHARED-NEXT: %s:_(s32) = G_XOR %a, %b
    ; SHARED-NEXT: %r:_(s32) = G_XOR %b, %c
    ; SHARED-NEXT: $vgpr0 = COPY %r(s32)
    ; SHARED-NEXT: $vgpr1 = COPY %s(s32)
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c:_(s32) = COPY $vgpr2
    %s:_(s32) = G_XOR %a, %b
    %t:_(s32) = G_XOR %s, %c
    %r:_(s32) = G_XOR %t, %a
    $vgpr0 = COPY %r
    $vgpr1 = COPY %s
...

# A loop-carried value: the G_PHI is a leaf and the walk stops there.
# ((acc + 7) + a) + 9 -> (acc + a) + 16
---
name: add_phi_cycle
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: add_phi_cycle
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %a:_(s32) = COPY $vgpr0
  ; CHECK-NEXT:   %n:_(s32) = COPY $vgpr1
  ; CHECK-NEXT:   %zero:_(s32) = G_CONSTANT i32 0
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %acc:_(s32) = G_PHI %zero(s32), %bb.0, %next(s32), %bb.1
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 16
  ; CHECK-NEXT:   [[ADD:%[0-9]+]]:_(s32) = G_ADD %acc, %a
  ; CHECK-NEXT:   %next:_(s32) = G_ADD [[ADD]], [[C]]
  ; CHECK-NEXT:   %cmp:_(s1) = G_ICMP intpred(ult), %next(s32), %n
  ; CHECK-NEXT:   G_BRCOND %cmp(s1), %bb.1
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $vgpr0 = COPY %next(s32)
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $vgpr1
    %a:_(s32) = COPY $vgpr0
    %n:_(s32) = COPY $vgpr1
    %zero:_(s32) = G_CONSTANT i32 0
    %c7:_(s32) = G_CONSTANT i32 7
    %c9:_(s32) = G_CONSTANT i32 9
    G_BR %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    %acc:_(s32) = G_PHI %zero(s32), %bb.0, %next(s32), %bb.1
    %t0:_(s32) = G_ADD %acc, %c7
    %t1:_(s32) = G_ADD %t0, %a
    %next:_(s32) = G_ADD %t1, %c9
    %cmp:_(s1) = G_ICMP intpred(ult), %next(s32), %n
    G_BRCOND %cmp(s1), %bb.1
    G_BR %bb.2

  bb.2:
    $vgpr0 = COPY %next
    SI_RETURN implicit $vgpr0
...

# Eight leaves are within the budget: (((((((a + 1) + b) + c) + d) + e) + f) + 2)
---
name: add_eight_leaves
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3, $vgpr4, $vgpr5
    ; CHECK-LABEL: name: add_eight_leaves
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3, $vgpr4, $vgpr5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: %c:_(s32) = COPY $vgpr2
    ; CHECK-NEXT: %d:_(s32) = COPY $vgpr3
    ; CHECK-NEXT: %e:_(s32) = COPY $vgpr4
    ; CHECK-NEXT: %f:_(s32) = COPY $vgpr5
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 3
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(s32) = G_ADD %a, %b
    ; CHECK-NEXT: [[ADD1:%[0-9]+]]:_(s32) = G_ADD [[ADD]], %c
    ; CHECK-NEXT: [[ADD2:%[0-9]+]]:_(s32) = G_ADD [[ADD1]], %d
    ; CHECK-NEXT: [[ADD3:%[0-9]+]]:_(s32) = G_ADD [[ADD2]], %e
    ; CHECK-NEXT: [[ADD4:%[0-9]+]]:_(s32) = G_ADD [[ADD3]], %f
    ; CHECK-NEXT: %r:_(s32) = G_ADD [[ADD4]], [[C]]
    ; CHECK-NEXT: $vgpr0 = COPY %r(s32)
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c:_(s32) = COPY $vgpr2
    %d:_(s32) = COPY $vgpr3
    %e:_(s32) = COPY $vgpr4
    %f:_(s32) = COPY $vgpr5
    %c1:_(s32) = G_CONSTANT i32 1
    %c2:_(s32) = G_CONSTANT i32 2
    %s0:_(s32) = G_ADD %a, %c1
    %s1:_(s32) = G_ADD %s0, %b
    %s2:_(s32) = G_ADD %s1, %c
    %s3:_(s32) = G_ADD %s2, %d
    %s4:_(s32) = G_ADD %s3, %e
    %s5:_(s32) = G_ADD %s4, %f
    %r:_(s32) = G_ADD %s5, %c2
    $vgpr0 = COPY %r
...

# Nine leaves are over the budget: nothing changes.
---
name: add_nine_leaves
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3, $vgpr4, $vgpr5, $vgpr6
    ; CHECK-LABEL: name: add_nine_leaves
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3, $vgpr4, $vgpr5, $vgpr6
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: %c:_(s32) = COPY $vgpr2
    ; CHECK-NEXT: %d:_(s32) = COPY $vgpr3
    ; CHECK-NEXT: %e:_(s32) = COPY $vgpr4
    ; CHECK-NEXT: %f:_(s32) = COPY $vgpr5
