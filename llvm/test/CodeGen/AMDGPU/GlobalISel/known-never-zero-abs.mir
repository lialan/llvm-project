  ; CHECK-NEXT: %abs_nonzero:_ KnownBits:000000000000000000000000000000?? SignBits:30 IsKnownNeverZero:1
  ; CHECK-NEXT: %abs_may_zero:_ KnownBits:000000000000000000000000000000?0 SignBits:30 IsKnownNeverZero:0
    %cond:_(s1) = G_IMPLICIT_DEF
    %zero:_(s32) = G_CONSTANT i32 0
    %one:_(s32) = G_CONSTANT i32 1
    %negative_two:_(s32) = G_CONSTANT i32 -2
    %selected_nonzero:_(s32) = G_SELECT %cond, %one, %negative_two
    %selected_may_zero:_(s32) = G_SELECT %cond, %zero, %negative_two
    %abs_nonzero:_(s32) = G_ABS %selected_nonzero
