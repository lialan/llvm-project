    ; CHECK-NEXT: %mask:_(i64) = G_CONSTANT i64 1
    ; CHECK-NEXT: %e:_(i64) = G_ANYEXT %x(i32)
    ; CHECK-NEXT: %r:_(i64) = G_AND %e, %mask
    ; CHECK-NEXT: $vgpr0_vgpr1 = COPY %r(i64)
    %x:_(i32) = COPY $vgpr0
    %mask:_(i64) = G_CONSTANT i64 1
    %e:_(i64) = G_ANYEXT %x
    %r:_(i64) = G_AND %e, %mask
    $vgpr0_vgpr1 = COPY %r
...

