    %0:_(s32) = COPY $w0
    %1:_(s64) = G_ZEXT %0(s32)
    %2:_(s64) = G_CONSTANT i64 32
    %3:_(s64) = G_LSHR %1, %2
    %4:_(s32) = G_TRUNC %3(s64)
    $w0 = COPY %4(s32)
    RET_ReallyLR implicit $w0
...

