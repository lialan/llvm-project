# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=aarch64-prelegalizer-combiner -aarch64prelegalizercombiner-only-enable-rule=bitfield_view %s -o - | FileCheck %s
# REQUIRES: asserts

# ((x >> 4) & 255) >> 2 & 15 is zext(x[6, 10)).
---
name: nested_unsigned
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: nested_unsigned
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $w0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 6
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 4
    ; CHECK-NEXT: %d:_(i32) = G_UBFX %x, [[C]](i32), [[C1]]
    ; CHECK-NEXT: $w0 = COPY %d(i32)
    %x:_(i32) = COPY $w0
    %c4:_(i32) = G_CONSTANT i32 4
    %c255:_(i32) = G_CONSTANT i32 255
    %c2:_(i32) = G_CONSTANT i32 2
    %c15:_(i32) = G_CONSTANT i32 15
    %a:_(i32) = G_LSHR %x, %c4
    %b:_(i32) = G_AND %a, %c255
    %c:_(i32) = G_LSHR %b, %c2
    %d:_(i32) = G_AND %c, %c15
    $w0 = COPY %d
...

# ((x >>a 4) << 16) >>a 20 is sext(x[8, 20)).
---
name: nested_signed
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: nested_signed
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $w0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 8
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 12
    ; CHECK-NEXT: %c:_(i32) = G_SBFX %x, [[C]](i32), [[C1]]
    ; CHECK-NEXT: $w0 = COPY %c(i32)
    %x:_(i32) = COPY $w0
    %c4:_(i32) = G_CONSTANT i32 4
    %c16:_(i32) = G_CONSTANT i32 16
    %c20:_(i32) = G_CONSTANT i32 20
    %a:_(i32) = G_ASHR %x, %c4
    %b:_(i32) = G_SHL %a, %c16
    %c:_(i32) = G_ASHR %b, %c20
    $w0 = COPY %c
...

# A field of an i64 value.
---
name: nested_i64
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0
    ; CHECK-LABEL: name: nested_i64
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i64) = COPY $x0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 12
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 8
    ; CHECK-NEXT: %d:_(i64) = G_UBFX %x, [[C]](i64), [[C1]]
    ; CHECK-NEXT: $x0 = COPY %d(i64)
    %x:_(i64) = COPY $x0
    %c8:_(i64) = G_CONSTANT i64 8
    %cffffff:_(i64) = G_CONSTANT i64 16777215
    %c4:_(i64) = G_CONSTANT i64 4
    %cff:_(i64) = G_CONSTANT i64 255
    %a:_(i64) = G_LSHR %x, %c8
    %b:_(i64) = G_AND %a, %cffffff
    %c:_(i64) = G_LSHR %b, %c4
    %d:_(i64) = G_AND %c, %cff
    $x0 = COPY %d
...

# trunc((x >> 20) & 0xffff) >> 4 & 0xff of an i64 x is zext(x[24, 32)).
---
name: field_of_i64
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0
    ; CHECK-LABEL: name: field_of_i64
    ; CHECK: liveins: $x0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i64) = COPY $x0
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(i32) = G_TRUNC %x(i64)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 24
    ; CHECK-NEXT: %e:_(i32) = G_LSHR [[TRUNC]], [[C]](i32)
    ; CHECK-NEXT: $w0 = COPY %e(i32)
    %x:_(i64) = COPY $x0
    %c20:_(i64) = G_CONSTANT i64 20
    %cffff:_(i64) = G_CONSTANT i64 65535
    %c4:_(i32) = G_CONSTANT i32 4
    %cff:_(i32) = G_CONSTANT i32 255
    %a:_(i64) = G_LSHR %x, %c20
    %b:_(i64) = G_AND %a, %cffff
    %c:_(i32) = G_TRUNC %b
    %d:_(i32) = G_LSHR %c, %c4
    %e:_(i32) = G_AND %d, %cff
    $w0 = COPY %e
...

# Bits [36, 44) of the concatenation of lo and hi are hi[4, 12).
---
name: field_of_merge
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0, $w1
    ; CHECK-LABEL: name: field_of_merge
    ; CHECK: liveins: $w0, $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %hi:_(i32) = COPY $w1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 4
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 8
    ; CHECK-NEXT: %c:_(i32) = G_UBFX %hi, [[C]](i32), [[C1]]
    ; CHECK-NEXT: $w0 = COPY %c(i32)
    %lo:_(i32) = COPY $w0
    %hi:_(i32) = COPY $w1
    %c36:_(i64) = G_CONSTANT i64 36
    %cff:_(i32) = G_CONSTANT i32 255
    %m:_(i64) = G_MERGE_VALUES %lo, %hi
    %a:_(i64) = G_LSHR %m, %c36
    %b:_(i32) = G_TRUNC %a
    %c:_(i32) = G_AND %b, %cff
    $w0 = COPY %c
...

# The mask 0xf0f selects two fields.
---
name: two_field_mask
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: two_field_mask
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $w0
    ; CHECK-NEXT: %c4:_(i32) = G_CONSTANT i32 4
    ; CHECK-NEXT: %cf0f:_(i32) = G_CONSTANT i32 3855
    ; CHECK-NEXT: %c2:_(i32) = G_CONSTANT i32 2
    ; CHECK-NEXT: %a:_(i32) = G_LSHR %x, %c4(i32)
    ; CHECK-NEXT: %b:_(i32) = G_AND %a, %cf0f
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 10
    ; CHECK-NEXT: %d:_(i32) = G_UBFX %b, %c2(i32), [[C]]
    ; CHECK-NEXT: $w0 = COPY %d(i32)
    %x:_(i32) = COPY $w0
    %c4:_(i32) = G_CONSTANT i32 4
    %cf0f:_(i32) = G_CONSTANT i32 3855
    %c2:_(i32) = G_CONSTANT i32 2
    %c3ff:_(i32) = G_CONSTANT i32 1023
    %a:_(i32) = G_LSHR %x, %c4
    %b:_(i32) = G_AND %a, %cf0f
    %c:_(i32) = G_LSHR %b, %c2
    %d:_(i32) = G_AND %c, %c3ff
    $w0 = COPY %d
...

# A shift by 40 of an i32 value is poison: the view does not look through it.
---
name: out_of_range_shift
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: out_of_range_shift
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $w0
    ; CHECK-NEXT: %c4:_(i32) = G_CONSTANT i32 4
    ; CHECK-NEXT: %c40:_(i32) = G_CONSTANT i32 40
    ; CHECK-NEXT: %c15:_(i32) = G_CONSTANT i32 15
    ; CHECK-NEXT: %a:_(i32) = G_LSHR %x, %c4(i32)
    ; CHECK-NEXT: %b:_(i32) = G_LSHR %a, %c40(i32)
    ; CHECK-NEXT: %c:_(i32) = G_AND %b, %c15
    ; CHECK-NEXT: $w0 = COPY %c(i32)
    %x:_(i32) = COPY $w0
    %c4:_(i32) = G_CONSTANT i32 4
    %c40:_(i32) = G_CONSTANT i32 40
    %c15:_(i32) = G_CONSTANT i32 15
    %a:_(i32) = G_LSHR %x, %c4
    %b:_(i32) = G_LSHR %a, %c40
    %c:_(i32) = G_AND %b, %c15
    $w0 = COPY %c
...

# A G_UBFX of 16 bits at bit 20 of an i32 value is poison: the view does not
# look through it.
---
name: width_overflow
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: width_overflow
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $w0
    ; CHECK-NEXT: %c20:_(i32) = G_CONSTANT i32 20
    ; CHECK-NEXT: %c16:_(i32) = G_CONSTANT i32 16
    ; CHECK-NEXT: %c4:_(i32) = G_CONSTANT i32 4
    ; CHECK-NEXT: %u:_(i32) = G_UBFX %x, %c20(i32), %c16
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 8
    ; CHECK-NEXT: %b:_(i32) = G_UBFX %u, %c4(i32), [[C]]
    ; CHECK-NEXT: $w0 = COPY %b(i32)
    %x:_(i32) = COPY $w0
    %c20:_(i32) = G_CONSTANT i32 20
    %c16:_(i32) = G_CONSTANT i32 16
    %c4:_(i32) = G_CONSTANT i32 4
    %cff:_(i32) = G_CONSTANT i32 255
    %u:_(i32) = G_UBFX %x, %c20, %c16
    %a:_(i32) = G_LSHR %u, %c4
    %b:_(i32) = G_AND %a, %cff
    $w0 = COPY %b
...
