# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn-amd-amdhsa -run-pass=gisel-egraph-combiner -gisel-egraph-mode=rewrite %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -run-pass=amdgpu-prelegalizer-combiner %s -o - | FileCheck --check-prefix=BASELINE %s

# Rewrite mode of the experimental e-graph combiner. The BASELINE prefix shows
# what the existing AMDGPU pre-legalizer combiner does with the same input.

---
# (a + b) * c + (b + a) * d  ==>  (a + b) * (c + d)
# Needs commutativity (to identify a+b and b+a) and factoring.
name: factor_with_commute
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; CHECK-LABEL: name: factor_with_commute
    ; CHECK: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: %c:_(s32) = COPY $vgpr2
    ; CHECK-NEXT: %d:_(s32) = COPY $vgpr3
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(s32) = G_ADD %a, %b
    ; CHECK-NEXT: [[ADD1:%[0-9]+]]:_(s32) = G_ADD %c, %d
    ; CHECK-NEXT: [[MUL:%[0-9]+]]:_(s32) = G_MUL [[ADD]], [[ADD1]]
    ; CHECK-NEXT: $vgpr0 = COPY [[MUL]](s32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0
    ;
    ; BASELINE-LABEL: name: factor_with_commute
    ; BASELINE: liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3
    ; BASELINE-NEXT: {{  $}}
    ; BASELINE-NEXT: %a:_(s32) = COPY $vgpr0
    ; BASELINE-NEXT: %b:_(s32) = COPY $vgpr1
    ; BASELINE-NEXT: %c:_(s32) = COPY $vgpr2
    ; BASELINE-NEXT: %d:_(s32) = COPY $vgpr3
    ; BASELINE-NEXT: %ab:_(s32) = G_ADD %a, %b
    ; BASELINE-NEXT: %ba:_(s32) = G_ADD %b, %a
    ; BASELINE-NEXT: %m1:_(s32) = G_MUL %ab, %c
    ; BASELINE-NEXT: %m2:_(s32) = G_MUL %ba, %d
    ; BASELINE-NEXT: %r:_(s32) = G_ADD %m1, %m2
    ; BASELINE-NEXT: $vgpr0 = COPY %r(s32)
    ; BASELINE-NEXT: SI_RETURN implicit $vgpr0
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c:_(s32) = COPY $vgpr2
    %d:_(s32) = COPY $vgpr3
    %ab:_(s32) = G_ADD %a, %b
    %ba:_(s32) = G_ADD %b, %a
    %m1:_(s32) = G_MUL %ab, %c
    %m2:_(s32) = G_MUL %ba, %d
    %r:_(s32) = G_ADD %m1, %m2
    $vgpr0 = COPY %r
    SI_RETURN implicit $vgpr0
...
---
