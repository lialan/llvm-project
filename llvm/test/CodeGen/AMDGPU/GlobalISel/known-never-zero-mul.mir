    %two:_(s32) = G_CONSTANT i32 2
    %unknown0:_(s32) = G_IMPLICIT_DEF
    %unknown1:_(s32) = G_IMPLICIT_DEF
    %nonzero0:_(s32) = G_OR %unknown0, %one
    %nonzero1:_(s32) = G_OR %unknown1, %two
    %nuw_nonzero:_(s32) = nuw G_MUL %nonzero0, %nonzero1
    %nsw_nonzero:_(s32) = nsw G_MUL %nonzero0, %nonzero1
    %unflagged:_(s32) = G_MUL %nonzero0, %nonzero1
    %one_operand_may_zero:_(s32) = nuw G_MUL %nonzero0, %unknown1
