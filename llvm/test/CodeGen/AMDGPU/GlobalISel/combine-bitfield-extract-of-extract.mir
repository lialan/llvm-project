# (ashr (sext_inreg (shl x, c), n), c) is a sign extension of the low n - c bits.
---
name: ashr_sext_inreg_shl
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: ashr_sext_inreg_shl
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %r:_(i32) = G_SEXT_INREG %x, 12
    ; CHECK-NEXT: $vgpr0 = COPY %r(i32)
    %x:_(i32) = COPY $vgpr0
    %c4:_(i32) = G_CONSTANT i32 4
    %shl:_(i32) = G_SHL %x, %c4
    %sext:_(i32) = G_SEXT_INREG %shl, 16
    %r:_(i32) = G_ASHR %sext, %c4
    $vgpr0 = COPY %r
...

