name: shuffle_v2s32_vgpr_swap
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1
    ; GFX90A-LABEL: name: shuffle_v2s32_vgpr_swap
