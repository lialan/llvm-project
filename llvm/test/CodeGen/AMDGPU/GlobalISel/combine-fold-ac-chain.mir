# (a + 7) + (b + 9) -> (a + b) + 16
---
name: add_constants
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: add_constants
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 16
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(s32) = G_ADD %a, %b
    ; CHECK-NEXT: %r:_(s32) = G_ADD [[ADD]], [[C]]
    ; CHECK-NEXT: $vgpr0 = COPY %r(s32)
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %c7:_(s32) = G_CONSTANT i32 7
    %c9:_(s32) = G_CONSTANT i32 9
    %x:_(s32) = G_ADD %a, %c7
    %y:_(s32) = G_ADD %b, %c9
    %r:_(s32) = G_ADD %x, %y
    $vgpr0 = COPY %r
...

# The constants are added modulo 2^32: (a + -1) + (b + 2) -> (a + b) + 1
---
name: add_constants_wrap
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: add_constants_wrap
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 1
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:_(s32) = G_ADD %a, %b
    ; CHECK-NEXT: %r:_(s32) = G_ADD [[ADD]], [[C]]
    ; CHECK-NEXT: $vgpr0 = COPY %r(s32)
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %cm1:_(s32) = G_CONSTANT i32 -1
    %c2:_(s32) = G_CONSTANT i32 2
    %x:_(s32) = G_ADD %a, %cm1
    %y:_(s32) = G_ADD %b, %c2
    %r:_(s32) = G_ADD %x, %y
    $vgpr0 = COPY %r
...

# The constants add up to 0: (a + 0x80000000) + (b + 0x80000000) -> a + b
---
name: add_constants_wrap_to_zero
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; CHECK-LABEL: name: add_constants_wrap_to_zero
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: %b:_(s32) = COPY $vgpr1
    ; CHECK-NEXT: %r:_(s32) = G_ADD %a, %b
    ; CHECK-NEXT: $vgpr0 = COPY %r(s32)
    %a:_(s32) = COPY $vgpr0
    %b:_(s32) = COPY $vgpr1
    %min:_(s32) = G_CONSTANT i32 -2147483648
    %x:_(s32) = G_ADD %a, %min
    %y:_(s32) = G_ADD %b, %min
    %r:_(s32) = G_ADD %x, %y
    $vgpr0 = COPY %r
...

# A repeated leaf is kept: (a + 3) + (a + 5) -> (a << 1) + 8
---
name: add_repeated_leaf
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: add_repeated_leaf
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %a:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 1
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(s32) = G_SHL %a, [[C]](s32)
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(s32) = G_CONSTANT i32 8
    ; CHECK-NEXT: %r:_(s32) = G_ADD [[SHL]], [[C1]]
    ; CHECK-NEXT: $vgpr0 = COPY %r(s32)
    %a:_(s32) = COPY $vgpr0
    %c3:_(s32) = G_CONSTANT i32 3
    %c5:_(s32) = G_CONSTANT i32 5
    %x:_(s32) = G_ADD %a, %c3
    %y:_(s32) = G_ADD %a, %c5
    %r:_(s32) = G_ADD %x, %y
    $vgpr0 = COPY %r
...

