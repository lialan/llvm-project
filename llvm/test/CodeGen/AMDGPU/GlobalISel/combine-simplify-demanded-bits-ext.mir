# A sign extension of a value whose sign bit is known zero is a zero extension.
---
name: sext_nonneg
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: sext_nonneg
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(i32) = COPY $vgpr0
    ; CHECK-NEXT: %c:_(i32) = G_CONSTANT i32 32767
    ; CHECK-NEXT: %y:_(i32) = G_AND %x, %c
    ; CHECK-NEXT: [[ZEXT:%[0-9]+]]:_(i64) = G_ZEXT %y(i32)
    ; CHECK-NEXT: $vgpr0_vgpr1 = COPY [[ZEXT]](i64)
    %x:_(i32) = COPY $vgpr0
    %c:_(i32) = G_CONSTANT i32 32767
    %y:_(i32) = G_AND %x, %c
    %r:_(i64) = G_SEXT %y
    $vgpr0_vgpr1 = COPY %r
...

